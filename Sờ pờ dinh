-- ====================================================================
-- THE REAL PRESSURE STAMINA UI (FULL SPRITESHEET REPLICA) + MOBILE BUTTON
-- EXECUTOR COMPATIBLE VERSION (LEFT ALT KEYBIND & UPDATED SPEED)
-- ====================================================================
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local playerGui = player:WaitForChild("PlayerGui")
local IsPC = UserInputService.KeyboardEnabled

-- ====================================================================
-- KHỞI TẠO TÍN HIỆU TOÀN CỤC CHO EXECUTOR (GETGENV)
-- ====================================================================
getgenv().DisableSprint = false   -- Tín hiệu 1: Bật true để cấm Sprint
getgenv().HighRiskSprint = false  -- Tín hiệu 2: Bật true để Buff x1.25 tốc độ, x2 thời gian, stamina = 0 -> chết

-- ====================================================================
-- HÀM GIẾT NGƯỜI CHƠI KHI HẾT STAMINA TRONG CHẾ ĐỘ BUFF
-- ====================================================================
local function killOneShot()
    local damageRemote = ReplicatedStorage:FindFirstChild("LocalDamage", true) or ReplicatedStorage:FindFirstChild("ChangeHealth", true)
    
    if damageRemote and damageRemote:IsA("RemoteEvent") then
        damageRemote:FireServer(1000, "SittingItOut", 1, nil)
        damageRemote:FireServer("Damage", 1000)
        print("ngol")
    else
        print("đéo được")
    end
end

-- 1. KHỞI TẠO VÀ NHÂN BẢN GIAO DIỆN GỐC TỪ GAME
local mainGui = playerGui:WaitForChild("Main")
local healthBarOriginal = mainGui:FindFirstChild("Health") or mainGui:FindFirstChild("Health", true)
if not healthBarOriginal then
	warn("❌ [Stamina Error]: Không tìm thấy thanh Health gốc của Pressure!")
	return
end

-- Tự động dọn dẹp bản sao cũ nếu có để tránh lỗi chồng chéo giao diện
local oldStamina = mainGui:FindFirstChild("Stamina", true)
if oldStamina then
	oldStamina:Destroy()
end

local staminaBar = healthBarOriginal:Clone()
staminaBar.Name = "Stamina"
staminaBar.Size = UDim2.new(0.200000003, 0, 0.100000001, 0)
staminaBar.Parent = healthBarOriginal.Parent
staminaBar.Visible = true

local BASE_POS = UDim2.new(0.119999997, 0, 0.992489278, 0)
staminaBar.Position = BASE_POS

local baseHeight = healthBarOriginal.AbsoluteSize.Y
local function UpdatePosition()
	local extra = healthBarOriginal.AbsoluteSize.Y - baseHeight
	staminaBar.Position = UDim2.new(
		BASE_POS.X.Scale,
		BASE_POS.X.Offset,
		BASE_POS.Y.Scale,
		BASE_POS.Y.Offset + extra
	)
end
UpdatePosition()
healthBarOriginal:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdatePosition)

local staminaImageLabel = staminaBar:FindFirstChild("ImageLabel", true)
local staminaSkull = staminaBar:FindFirstChild("Skull", true)
local originalHealthColor = Color3.fromRGB(255,255,255)
if staminaImageLabel then
	originalHealthColor = staminaImageLabel.ImageColor3
end

local textLabel = staminaBar:FindFirstChild("TextLabel", true)
if textLabel and textLabel:IsA("TextLabel") then
	textLabel.Visible = false
end

