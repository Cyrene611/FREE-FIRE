local function createGlitch(targetImage, numSlices)
	if not targetImage or not targetImage:IsA("ImageLabel") then return nil end
	
	local oldContainer = targetImage:FindFirstChild("GlitchContainer")
	if oldContainer then oldContainer:Destroy() end

	local container = Instance.new("Frame")
	container.Name = "GlitchContainer"
	container.BackgroundTransparency = 1
	container.Size = UDim2.new(1, 0, 1, 0)
	container.Position = UDim2.new(0, 0, 0, 0)
	container.ZIndex = targetImage.ZIndex + 2
	container.Parent = targetImage

	local slices = {}
	for i = 1, numSlices do
		local slice = Instance.new("Frame")
		slice.Name = "Slice_" .. i
		slice.BackgroundTransparency = 1
		slice.ClipsDescendants = true
		slice.Size = UDim2.new(1, 0, 1 / numSlices, 0)
		slice.Position = UDim2.new(0, 0, (i - 1) / numSlices, 0)
		slice.ZIndex = container.ZIndex
		slice.Parent = container

		local img = Instance.new("ImageLabel")
		img.Name = "SliceImg"
		img.BackgroundTransparency = 1
		img.Image = targetImage.Image
		img.ImageColor3 = targetImage.ImageColor3
		img.ScaleType = targetImage.ScaleType
		img.Size = UDim2.new(1, 0, numSlices, 0)
		img.Position = UDim2.new(0, 0, -(i - 1), 0)
		img.ZIndex = slice.ZIndex
		img.Parent = slice

		table.insert(slices, {Slice = slice, Img = img, BaseY = (i - 1) / numSlices})
	end

	targetImage.ImageTransparency = 1

	return {
		Update = function(maxOffset)
			targetImage.ImageTransparency = 1
			for _, item in ipairs(slices) do
				item.Img.Image = targetImage.Image
				item.Img.ImageColor3 = targetImage.ImageColor3
				if math.random(1, 3) ~= 1 then
					local offset = math.random(-maxOffset, maxOffset)
					item.Slice.Position = UDim2.new(0, offset, item.BaseY, 0)
				else
					item.Slice.Position = UDim2.new(0, 0, item.BaseY, 0)
				end
			end
		end,
		Stop = function()
			container:Destroy()
			targetImage.ImageTransparency = 0
		end
	}
end

