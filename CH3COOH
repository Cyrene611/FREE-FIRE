-- =====================================================================
-- HÀM KIỂM TRA CHẤT LIỆU DẪN ĐIỆN (KIM LOẠI VÀ NƯỚC)
-- =====================================================================
local function isConductive(part)
    if not part or not part:IsA("BasePart") then return false end
    
    if part.Material == Enum.Material.Metal 
       or part.Material == Enum.Material.DiamondPlate 
       or part.Material == Enum.Material.Water then
        return true
    end
    
    local c = part.Color
    local r = math.floor(c.R * 255 + 0.5)
    local g = math.floor(c.G * 255 + 0.5)
    local b = math.floor(c.B * 255 + 0.5)
    
    if r == 5 and g == 44 and b == 72 then
        return true
    end
    
    return false
end

-- =====================================================================
-- HÀM TẠO PARTICLE EMITTER ĐIỆN
-- =====================================================================
local function createElectricParticle()
    local particle = Instance.new("ParticleEmitter")
    particle.Name = "ElectricEffect"
    particle.Texture = "rbxassetid://82565621414094"
    particle.Enabled = true
    
    particle.LightEmission = 1
    particle.LightInfluence = 0
    particle.Rate = 222
    particle.Lifetime = NumberRange.new(0.05, 0.2)
    particle.Speed = NumberRange.new(1, 4)
    particle.SpreadAngle = Vector2.new(60, 60)
    
    particle.Rotation = NumberRange.new(-180, 180)
    particle.RotSpeed = NumberRange.new(-720, 720)
    
    particle.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.4, 0.3),
        NumberSequenceKeypoint.new(0.5, 0.8, 0.4),
        NumberSequenceKeypoint.new(1, 0.1, 0.1)
    })
    
    particle.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(0.5, 0),
        NumberSequenceKeypoint.new(1, 1)
    })
    
    particle.EmissionDirection = Enum.NormalId.Top
    return particle
end

-- =====================================================================
-- HÀM GẮN PARTICLE VÀ XỬ LÝ FADE OUT (7S THƯỜNG + 5S TWEEN MỜ/THU NHỎ)
-- =====================================================================
local function applyElectricWithFade(part)
    if not part or part:FindFirstChild("ElectricEffect") then return end

    local electric = createElectricParticle()
    electric.Parent = part

    task.spawn(function()
        -- 1. Giữ nguyên 7 giây đầu tiên
        task.wait(7)

        -- 2. Tween thu nhỏ & mờ dần trong 5 giây tiếp theo
        local duration = 5
        local elapsed = 0
        local initialRate = electric.Rate

        while elapsed < duration do
            local dt = task.wait(0.05)
            elapsed = elapsed + dt
            local alpha = math.clamp(elapsed / duration, 0, 1)

            if not electric or not electric.Parent then break end

            local scale = 1 - alpha

            electric.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, math.max(0.01, 0.4 * scale), 0.1 * scale),
                NumberSequenceKeypoint.new(0.5, math.max(0.01, 0.8 * scale), 0.1 * scale),
                NumberSequenceKeypoint.new(1, 0.01, 0.01)
            })

            electric.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.1 + 0.9 * alpha),
                NumberSequenceKeypoint.new(0.5, 0 + 1.0 * alpha),
                NumberSequenceKeypoint.new(1, 1)
            })

            electric.Rate = initialRate * scale
        end

        if electric then
            electric:Destroy()
        end
    end)
end

