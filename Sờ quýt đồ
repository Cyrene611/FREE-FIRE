end

local function GetRandomSpawnPosition()

    local Floor = FloorParts[math.random(1, #FloorParts)]

    local X = (math.random() - 0.5) * Floor.Size.X * 0.7
    local Z = (math.random() - 0.5) * Floor.Size.Z * 0.7

    local Position = Floor.CFrame:PointToWorldSpace(
        Vector3.new(
            X,
            Floor.Size.Y / 2 + 5,
            Z
        )
    )

    return Position
end

local function GitAud(soundgit, filename)

    local url = soundgit
    local FileName = filename

    writefile(FileName .. ".mp3", game:HttpGet(url))

    return (getcustomasset or getsynasset)(FileName .. ".mp3")

end

local function CustomGitSound(soundlink, volume, filename, soundName, parent, looped)

    local sound = Instance.new("Sound")

    sound.SoundId = GitAud(soundlink, filename)
    sound.Parent = parent or workspace
    sound.Volume = volume or 1
    sound.PlaybackSpeed = 1
    sound.Playing = false
    sound.Name = soundName or "bgtheme"
    sound.Looped = looped or false

    local pitchEffect = Instance.new("PitchShiftSoundEffect")
    pitchEffect.Octave = 0.75
    pitchEffect.Parent = sound

    return sound

end

local Log = ""

local function Add(Text)
    Log ..= Text .. "\n"
end

local Template = Models[1]

if not Template then
    warn("Không tìm thấy model Squiddles!")
    return
end

local SpawnedModels = {}

for i = 1, SpawnCount do

    local Obj

    if i == 1 then
        Obj = Template
    else
        Obj = Template:Clone()
    end

    table.insert(SpawnedModels, Obj)

end

for _, Obj in ipairs(SpawnedModels) do

    local OriginalTransparency = {}

    for _, v in ipairs(Obj:GetDescendants()) do
        if v:IsA("BasePart") then
            OriginalTransparency[v] = v.Transparency
            v.Transparency = 1

            if v.Color.R > 0.9 and v.Color.G > 0.9 and v.Color.B > 0.9 then
                v.Color = Color3.new(1, 0, 0)
            end
        end
    end

    if Obj:IsA("BasePart") then
        OriginalTransparency[Obj] = Obj.Transparency
        Obj.Transparency = 1

        if Obj.Color.R > 0.9 and Obj.Color.G > 0.9 and Obj.Color.B > 0.9 then
            Obj.Color = Color3.new(1, 0, 0)
        end
    end

    Obj.Parent = workspace

    local SpawnPosition = GetRandomSpawnPosition()
    local RandomRotation = math.rad(math.random(0, 359))

    if Obj:IsA("Model") then
        Obj:PivotTo(
            CFrame.new(SpawnPosition) *
            CFrame.Angles(0, RandomRotation, 0)
        )
    elseif Obj:IsA("BasePart") then
        Obj.CFrame =
            CFrame.new(SpawnPosition) *
            CFrame.Angles(0, RandomRotation, 0)
    end

    task.spawn(function()

        for Part, Transparency in pairs(OriginalTransparency) do

            if Part and Part.Parent then

                TweenService:Create(
                    Part,
                    TweenInfo.new(
                        0.75,
                        Enum.EasingStyle.Quad,
                        Enum.EasingDirection.Out
                    ),
                    {
                        Transparency = Transparency
                    }
                ):Play()

            end

        end

    end)

    task.spawn(function()

        CustomGitSound(
            "https://codeberg.org/qjjdjdjjd/cak/raw/branch/main/lv_0_20260716201056.mp3?raw=true",
            1.2,
            "squid" .. tostring(i),
            "squid",
            Obj,
            true
        )

    end)

    task.spawn(function()

        CustomGitSound(
            "https://codeberg.org/qjjdjdjjd/cak/raw/branch/main/lv_0_20260716211736%20%281%29.mp3?raw=true",
            1.2,
            "squidJUMP" .. tostring(i),
            "SUMSCARE",
            Obj,
            false
        )

    end)

    local Anim = ReplicatedStorage.Animations.Squiddles.Idle

    local Controller = Obj:FindFirstChildOfClass("AnimationController")

    local Animator

    if Controller then

        Animator = Controller:FindFirstChildOfClass("Animator")

        if not Animator then
            Animator = Instance.new("Animator")
            Animator.Parent = Controller
        end

        local Track = Animator:LoadAnimation(Anim)
        Track.Looped = true
        Track:Play()

    end

    local Body = Obj:FindFirstChild("Body", true)

    if Body then

        local Face = Body:FindFirstChild("Face")

        if Face and Face:IsA("Motor6D") and Face.Part1 then

            local Part = Face.Part1

            if #Faces > 0 then

                local Pick = Faces[math.random(#Faces)]

                local Gui = Instance.new("SurfaceGui")
                Gui.Name = "FaceGui"
                Gui.Face = Enum.NormalId.Front
                Gui.AlwaysOnTop = true
                Gui.LightInfluence = 0
                Gui.Parent = Part

                local Img = Instance.new("ImageLabel")
                Img.Name = "FaceImage"
                Img.BackgroundTransparency = 1
                Img.Size = UDim2.fromScale(1, 1)
                Img.Image = Pick
                Img.ImageColor3 = Color3.new(1, 0, 0)
                Img.ImageTransparency = 1
                Img.Position = UDim2.fromScale(0, 0.15)
                Img.Parent = Gui

                local Show = false
                local NearStart
                local Jumpscare = false
                local FadeTween
                local MoveTween

                local Tentacles = {}

                for _, v in ipairs(Obj:GetDescendants()) do
                    if v:IsA("BasePart") and v.Name:match("^Tentacle%d+$") then
                        Tentacles[#Tentacles + 1] = v
                    end
                end

                local TentacleTweens = {}

                local function TweenTentacles(Color)

                    for _, Tween in ipairs(TentacleTweens) do
                        Tween:Cancel()
                    end

                    table.clear(TentacleTweens)

                    for _, Tentacle in ipairs(Tentacles) do

                        local Tween = TweenService:Create(
                            Tentacle,
                            TweenInfo.new(0.3),
                            {
                                Color = Color
                            }
                        )

                        TentacleTweens[#TentacleTweens + 1] = Tween
                        Tween:Play()

                    end

                end

                local NormalPos = UDim2.fromScale(0, 0)
                local DownPos = UDim2.fromScale(0, 0.15)

                local function Fade(In)

                    if FadeTween then
                        FadeTween:Cancel()
                    end

                    if MoveTween then
                        MoveTween:Cancel()
                    end

                    if In then

                        Img.Position = DownPos

                        FadeTween = TweenService:Create(
                            Img,
                            TweenInfo.new(0.3),
                            {
                                ImageTransparency = 0
                            }
                        )

                        MoveTween = TweenService:Create(
                            Img,
                            TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                            {
                                Position = NormalPos
                            }
                        )

                    else

                        Img.Position = NormalPos

                        FadeTween = TweenService:Create(
                            Img,
                            TweenInfo.new(0.3),
                            {
                                ImageTransparency = 1
                            }
                        )

                        MoveTween = TweenService:Create(
                            Img,
                            TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                            {
                                Position = DownPos
                            }
                        )

                    end

                    FadeTween:Play()
                    MoveTween:Play()

                end

                local DetectDist = 7
                local DetectTime = 2.5

                local function HasEnabledEmitter(Model)

                    if not Model then
                        return false
                    end

                    for _, v in ipairs(Model:GetDescendants()) do
                        if v:IsA("ParticleEmitter") and v.Enabled then
                            return true
                        end
                    end

                    return false

                end

                local function LookingAtObj()

                    local Cam = workspace.CurrentCamera

                    local Dir = (Part.Position - Cam.CFrame.Position).Unit
                    local Dot = Cam.CFrame.LookVector:Dot(Dir)

                    return Dot >= 0.97

                end

                RunService.RenderStepped:Connect(function()

                    if not Obj.Parent then
                        return
                    end

                    if not HRP or not Part then
                        return
                    end

                    local Dist = (HRP.Position - Part.Position).Magnitude

                    DetectDist = 7
                    DetectTime = 2.5

                    local Lantern = Char:FindFirstChild("Lantern")

                    if Lantern and HasEnabledEmitter(Lantern) then
                        DetectDist = 23
                        DetectTime = 1
                    end

                    local Flashlight = Char:FindFirstChild("Flashlight")

                    if Flashlight and HasEnabledEmitter(Flashlight) and LookingAtObj() then
                        DetectDist = 33
                        DetectTime = 1
                    end

                    if Jumpscare then
                        return
                    end

                    if Dist <= DetectDist then

                        if not Show then

                            Show = true
                            NearStart = tick()

                            Fade(true)
                            TweenTentacles(Color3.new(1, 0, 0))

                            if Obj:FindFirstChild("squid") then
                                Obj.squid.Playing = true
                                Obj.squid:Play()
                            end

                        elseif NearStart and tick() - NearStart >= DetectTime then

                            Jumpscare = true

                            local Cam = workspace.CurrentCamera
                            local Root = Obj.PrimaryPart or Part

                            if Root then

                                local Dist = (HRP.Position - Root.Position).Magnitude

                                if Dist > 3 then

                                    local Look = (HRP.Position - Root.Position).Unit
                                    local TargetPos = HRP.Position - Look * 2.8

                                    local Tween = TweenService:Create(
                                        Root,
                                        TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                                        {
                                            CFrame = CFrame.new(TargetPos, HRP.Position)
                                        }
                                    )

                                    Tween:Play()

                                end

                                local Pivot = Obj:GetPivot()
                                local Pos = Pivot.Position

                                local CamY = workspace.CurrentCamera.CFrame.LookVector.Y

                                local YOffset = 0.8 + math.clamp(CamY * 8, -2, 5)

                                Obj:PivotTo(
                                    CFrame.new(
                                        Pos.X,
                                        Char.Head.Position.Y + YOffset,
                                        Pos.Z
                                    ) * (Pivot - Pivot.Position)
                                )

                            end

                            Obj.SUMSCARE:Play()

                            Obj.SUMSCARE.Ended:Once(function()

                                if Obj then
                                    Obj:Destroy()
                                end

                            end)

                            if Obj:FindFirstChild("squid") then
                                Obj.squid:Stop()
                                Obj.squid:Destroy()
                            end

                            local Head = Char:FindFirstChild("Head")

                            local JumpAnim = ReplicatedStorage.Animations.Squiddles.Jumpscare
                            local JumpTrack = Animator:LoadAnimation(JumpAnim)

                            JumpTrack.Looped = false
                            JumpTrack:Play()

                            local Follow

                            Follow = RunService.RenderStepped:Connect(function()

                                if not Obj.Parent or not HRP or not Head then
                                    if Follow then
                                        Follow:Disconnect()
                                    end
                                    return
                                end

                                local Pivot = Obj:GetPivot()
                                local Pos = Pivot.Position

                                Obj:PivotTo(
                                    CFrame.new(
                                        Pos.X,
                                        Head.Position.Y + 0.8,
                                        Pos.Z
                                    ) * (Pivot - Pivot.Position)
                                )

                            end)

                            JumpTrack.Stopped:Once(function()

                                if Follow then
                                    Follow:Disconnect()
                                end

                                local Main = LPlayer.PlayerGui:FindFirstChild("Main")

                                if Main then

                                    local Jump = Main:FindFirstChild("SquiddleJumpscare")
                                    local Border = Main:FindFirstChild("SquiddleBorder")

                                    if Jump and Border then

                                        local JumpClone = Jump:Clone()
                                        local BorderClone = Border:Clone()

                                        JumpClone.Parent = Main
                                        BorderClone.Parent = Main

                                        JumpClone.Visible = true
                                        BorderClone.Visible = true

                                        JumpClone.BackgroundTransparency = 0
                                        JumpClone.ImageTransparency = 0
                                        JumpClone.ScaleType = Enum.ScaleType.Fit
                                        BorderClone.ImageTransparency = 0

                                        JumpClone.Image = Pick
                                        JumpClone.ImageColor3 = Color3.new(1, 0, 0)

                                        task.delay(0.8, function()

                                            local function TweenObj(Obj)

                                                local Goal = {}

                                                if Obj:IsA("ImageLabel") or Obj:IsA("ImageButton") then
                                                    Goal.ImageTransparency = 1
                                                end

                                                if Obj:IsA("GuiObject") then
                                                    Goal.BackgroundTransparency = 1
                                                end

                                                if next(Goal) then

                                                    TweenService:Create(
                                                        Obj,
                                                        TweenInfo.new(3),
                                                        Goal
                                                    ):Play()

                                                end

                                            end

                                            TweenObj(JumpClone)

                                            local function killOneShot()

                                                local damageRemote =
                                                    ReplicatedStorage:FindFirstChild("LocalDamage", true)
                                                    or ReplicatedStorage:FindFirstChild("ChangeHealth", true)

                                                local randomDmg = math.random(35, 45)

                                                if damageRemote and damageRemote:IsA("RemoteEvent") then

                                                    damageRemote:FireServer(randomDmg, "SittingItOut", 1, nil)
                                                    damageRemote:FireServer("Damage", randomDmg)

                                                    print("ngol")

                                                else

                                                    print("đéo được")

                                                end

                                            end

                                            task.spawn(function()
                                                killOneShot()
                                            end)

                                            for _, v in ipairs(JumpClone:GetDescendants()) do
                                                TweenObj(v)
                                            end

                                        end)

                                        task.delay(1.8, function()

                                            local function TweenObj(Obj)

                                                local Goal = {}

                                                if Obj:IsA("ImageLabel") or Obj:IsA("ImageButton") then
                                                    Goal.ImageTransparency = 1
                                                end

                                                if Obj:IsA("GuiObject") then
                                                    Goal.BackgroundTransparency = 1
                                                end

                                                if next(Goal) then

                                                    TweenService:Create(
                                                        Obj,
                                                        TweenInfo.new(3),
                                                        Goal
                                                    ):Play()

                                                end

                                            end

                                            TweenObj(BorderClone)

                                            for _, v in ipairs(BorderClone:GetDescendants()) do
                                                TweenObj(v)
                                            end

                                        end)

                                        task.delay(4.8, function()

                                            JumpClone:Destroy()
                                            BorderClone:Destroy()

                                        end)

                                    end

                                end

                                for _, v in ipairs(Obj:GetDescendants()) do

                                    if v:IsA("BasePart") then
                                        v.Transparency = 1

                                    elseif v:IsA("SurfaceGui") then
                                        v:Destroy()
                                    end

                                end

                                Show = false
                                NearStart = nil
                                Jumpscare = false

                            end)

                        end

                    else

                        NearStart = nil

                        if Show then

                            Show = false

                            Fade(false)
                            TweenTentacles(Color3.new(0, 0, 0))

                            if Obj:FindFirstChild("squid") then
                                Obj.squid.Playing = false
                                Obj.squid:Stop()
                            end

                        end

                    end

                end)

            else

                Add("Không có Face!")

            end

        else

            Add("Không tìm thấy Motor6D Face hoặc Part1")

        end

    else

        Add("Không tìm thấy Body")

    end

end
