        local isCooldown = false 
        local isProxCooldown = false
        local isTouchElectricCooldown = false

        -- 4. VÒNG LẶP SÁT THƯƠNG & CHẠM CHẾT
        shockConnection = RunService.Heartbeat:Connect(function()
            local character = Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
            
            local entityModel = workspace:FindFirstChild("Conductor") 
            local entityRoot = entityModel and entityModel.PrimaryPart
            
            local touchingConductive = false
            local touchingElectrifiedPart = false

            if character and playerRoot and humanoid and humanoid.Health > 0 then
                local overlapParams = OverlapParams.new()
                overlapParams.FilterType = Enum.RaycastFilterType.Include
                overlapParams.FilterDescendantsInstances = {Rooms} 
                
                local touchingParts = workspace:GetPartsInPart(playerRoot, overlapParams)
                
                for _, bodyPart in ipairs(character:GetChildren()) do
                    if bodyPart:IsA("BasePart") then
                        local extraParts = workspace:GetPartsInPart(bodyPart, overlapParams)
                        for _, p in ipairs(extraParts) do
                            if not table.find(touchingParts, p) then
                                table.insert(touchingParts, p)
                            end
                        end
                    end
                end
                
                for _, part in ipairs(touchingParts) do
                    if isConductive(part) then
                        touchingConductive = true
                    end
                    -- Kiểm tra xem Part có đang bị dính hiệu ứng điện không
                    if part:FindFirstChild("ElectricEffect") then
                        touchingElectrifiedPart = true
                    end
                end
            end

            if humanoid and playerRoot and entityRoot and humanoid.Health > 0 then
                local distance = (playerRoot.Position - entityRoot.Position).Magnitude
                local damageRemote = game:GetService("ReplicatedStorage"):FindFirstChild("LocalDamage", true) or game:GetService("ReplicatedStorage"):FindFirstChild("ChangeHealth", true)

                -- A. CHẠM VÀO THỰC THỂ (CHẾT NGAY LẬP TỨC)
                if distance <= 5 then
                    if damageRemote and damageRemote:IsA("RemoteEvent") then
                        damageRemote:FireServer(1000, "SittingItOut", 1, nil)
                        damageRemote:FireServer("Damage", 1000)
                    end
                    humanoid.Health = 0
                    return
                end

                -- B. SÁT THƯƠNG BÁN KÍNH 15 STUDS (MẤT 10 HP / 0.65S + HIỆU ỨNG ĐIỆN PHÁT RA TỪ PLAYER 4.5S)
