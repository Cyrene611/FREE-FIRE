                SoundNear.RollOffMinDistance = 45
                SoundNear.RollOffMode = Enum.RollOffMode.Linear
                SoundNear.Looped = true
                SoundNear.Parent = entityRoot
                SoundNear:Play()
            end
        end)

        -- 3. VÒNG LẶP GẮN PARTICLE DUY TRÌ THEO CHÂN THỰC THỂ (BÁN KÍNH 60 STUDS)
        task.spawn(function()
            while entityActive do
                local entityModel = workspace:FindFirstChild("Conductor")
                local entityRoot = entityModel and (entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart"))
                
                if entityRoot then
                    local overlapParams = OverlapParams.new()
