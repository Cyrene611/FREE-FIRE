                        overlapParams.FilterDescendantsInstances = {Player.Character}
                    end
                    
                    local partsInRange = workspace:GetPartBoundsInRadius(entityRoot.Position, 60, overlapParams)
                    for _, part in ipairs(partsInRange) do
                        if part:IsA("BasePart") and isConductive(part) then
                            applyElectricWithFade(part)
                        end
                    end
