-- ====================================================================
-- CẤU HÌNH THÔNG SỐ VÀ TOÀN BỘ LOGIC HỆ THỐNG
-- ====================================================================
local Config = {
	MaxStamina = 100,
	CurrentStamina = 100,
	IsSprinting = false,
	Exhausted = false,
	Tired = false,
	TimeSinceStopped = 0,
	NormalSpeed = 14.5, -- Cập nhật tốc độ bình thường: 14.5
	SprintSpeed = 20,   -- Cập nhật tốc độ sprint: 20
	TiredSpeed = 9,
	SavedNormalFOV = camera.FieldOfView,
	FOVIncrease = 15,
}

local humanoid = nil
local rootPart = nil
local fovTween = nil
local BaseGameSpeed = 14.5 -- Tốc độ nền mặc định
local AnimationSpeedMultiplier = 1.5

-- Tối ưu RaycastParams chống va chạm tường
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function updatePOV(targetFOV)
	if fovTween then fovTween:Cancel() end
	fovTween = TweenService:Create(camera, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = targetFOV })
	fovTween:Play()
end

local function UpdateAnimationSpeed(multiplier)
	if not humanoid then return end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		track:AdjustSpeed(multiplier)
	end
end

local function StopSprint()
	if Config.IsSprinting then
		Config.IsSprinting = false
		UpdateAnimationSpeed(1)
		Config.TimeSinceStopped = tick()
		updatePOV(Config.SavedNormalFOV)
	end
end

local function updateStaminaUI(targetStamina)
	local max = Config.MaxStamina
	local current = math.clamp(targetStamina, 0, max)
	Config.CurrentStamina = current

	local v9 = (max - current) / 20
	local v10 = math.floor(v9)
	local v11 = (max - current - v10 * 20) / 5
	local v12 = math.floor(v11)

	if staminaImageLabel then
		staminaImageLabel.ImageRectOffset = Vector2.new(v12 * 205, v10 * 205)
	end

	local targetColor = Color3.fromRGB(130, 35, 35):Lerp(originalHealthColor, current / max)

	if not Config.Exhausted then
		if staminaImageLabel then staminaImageLabel.ImageColor3 = targetColor end
		if staminaSkull then staminaSkull.ImageColor3 = targetColor end
		if customImageLabel then customImageLabel.ImageColor3 = targetColor end
	end

	if current <= 0 then
		Config.Exhausted = true
		local exhaustedColor = Color3.fromRGB(80, 80, 80)
		if staminaImageLabel then staminaImageLabel.ImageColor3 = exhaustedColor end
		if staminaSkull then staminaSkull.ImageColor3 = exhaustedColor end
		if customImageLabel then customImageLabel.ImageColor3 = exhaustedColor end

		if Config.IsSprinting then
			StopSprint()
			Config.Tired = true
		end

		-- NẾU BẬT TÍN HIỆU 2 KHI HẾT STAMINA -> GIẾT NGƯỜI CHƠI
		if getgenv().HighRiskSprint then
			killOneShot()
		end
	else
		if current > (max * 0.75) then
			Config.Exhausted = false
			if staminaImageLabel then staminaImageLabel.ImageColor3 = targetColor end
			if staminaSkull then staminaSkull.ImageColor3 = targetColor end
			if customImageLabel then customImageLabel.ImageColor3 = targetColor end
		end
	end
end

local function onCharacterAdded(char)
	humanoid = char:WaitForChild("Humanoid")
	rootPart = char:WaitForChild("HumanoidRootPart")
	BaseGameSpeed = humanoid.WalkSpeed

	humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if not Config.IsSprinting then
			BaseGameSpeed = humanoid.WalkSpeed
		end
	end)

	updateStaminaUI(Config.MaxStamina)

	humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
		if humanoid.MoveDirection.Magnitude == 0 and Config.IsSprinting then
			StopSprint()
		end
	end)
end

if player.Character then onCharacterAdded(player.Character) end
player.CharacterAdded:Connect(onCharacterAdded)

local function StartSprint()
	-- Không cho phép Sprint nếu bị Cấm
	if getgenv().DisableSprint then return end

	if not Config.Exhausted and not Config.Tired and humanoid and humanoid.MoveDirection.Magnitude > 0 then
		Config.SavedNormalFOV = camera.FieldOfView
		Config.IsSprinting = true
		UpdateAnimationSpeed(AnimationSpeedMultiplier)
		updatePOV(Config.SavedNormalFOV + Config.FOVIncrease)
	end
end

-- BẮT SỰ KIỆN PHÍM BẤM PC (ĐỔI SANG LEFT ALT)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not IsPC then return end
	if input.KeyCode == Enum.KeyCode.LeftAlt then
		if Config.IsSprinting then
			StopSprint()
		else
			StartSprint()
		end
	end
end)

if mobileSprintButton then
	mobileSprintButton.MouseButton1Down:Connect(function()
		if Config.IsSprinting then
			StopSprint()
		else
			StartSprint()
		end
	end)
end

-- ====================================================================
-- VÒNG LẶP RENDER
-- ====================================================================
RunService.RenderStepped:Connect(function(deltaTime)
	-- Bị cấm Sprint mà đang Sprint -> Tắt ngay
	if getgenv().DisableSprint and Config.IsSprinting then
		StopSprint()
	end

	if humanoid and rootPart and humanoid.Parent and player.Character then
		local isAnchored = rootPart.Anchored
		local isSeated = (humanoid:GetState() == Enum.HumanoidStateType.Seated)

		if not Config.IsSprinting then
			BaseGameSpeed = humanoid.WalkSpeed
		elseif humanoid.WalkSpeed > BaseGameSpeed then
			BaseGameSpeed = humanoid.WalkSpeed
		end

		local targetSpeed = BaseGameSpeed

		if Config.IsSprinting and not Config.Tired then
			-- Tốc độ cơ bản khi Sprint = 20 (chênh lệch 5.5 so với 14.5)
			local bonusSpeed = 5.5
			if getgenv().HighRiskSprint then
				targetSpeed = (BaseGameSpeed + bonusSpeed) * 1.25
			else
				targetSpeed = BaseGameSpeed + bonusSpeed
			end
		elseif Config.Tired then
			targetSpeed = Config.TiredSpeed
		end

		if humanoid.MoveDirection.Magnitude > 0 and humanoid.WalkSpeed > 0 and not isAnchored and not isSeated then
			local currentGameSpeed = humanoid.WalkSpeed
			local speedDifference = targetSpeed - currentGameSpeed

			if math.abs(speedDifference) > 0.05 then
				local moveVector = humanoid.MoveDirection
				local microMove = moveVector * (speedDifference * deltaTime)

				-- KIỂM TRA XUYÊN TƯỜNG BẰNG RAYCAST
				rayParams.FilterDescendantsInstances = {player.Character}
				local rayOrigin = rootPart.Position
				local rayDirection = moveVector * (microMove.Magnitude + 1.2)
				local rayHit = workspace:Raycast(rayOrigin, rayDirection, rayParams)

				if not rayHit then
					rootPart.CFrame = rootPart.CFrame + Vector3.new(microMove.X, 0, microMove.Z)
				end
			end
		end
	end

	if Config.Tired and (tick() - Config.TimeSinceStopped > 3) then
		Config.Tired = false
	end

	-- Tiêu hao / Hồi phục thể lực
	if Config.IsSprinting and humanoid and humanoid.MoveDirection.Magnitude > 0 and not Config.Tired then
		local drainRate = getgenv().HighRiskSprint and 4.5 or 9
		updateStaminaUI(Config.CurrentStamina - drainRate * deltaTime)
	elseif (tick() - Config.TimeSinceStopped > 1.5) and not Config.IsSprinting and Config.CurrentStamina < Config.MaxStamina then
		updateStaminaUI(Config.CurrentStamina + 12 * deltaTime)
	end
end)
