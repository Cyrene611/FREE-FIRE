local function tweenModel(model, targetCFrame, duration, easingStyle, easingDirection)
    if not model or not model.Parent then return end
    local cframeValue = Instance.new("CFrameValue")
    cframeValue.Value = model:GetPivot()
    local tween = TweenService:Create(
        cframeValue,
        TweenInfo.new(duration, easingStyle or Enum.EasingStyle.Quad, easingDirection or Enum.EasingDirection.Out),
        {Value = targetCFrame}
    )
    local connection = cframeValue.Changed:Connect(function(newCFrame)
        if model and model.Parent then
            model:PivotTo(newCFrame)
        end
    end)
    tween:Play()
    tween.Completed:Wait()
    connection:Disconnect()
    cframeValue:Destroy()
end

local function fadeOutFX(obj, duration)
    duration = duration or 0.45
    if not obj or not obj.Parent then return end

    if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then
        local numVal = Instance.new("NumberValue")
        local startVal = 0
        pcall(function()
            startVal = obj.Transparency.Keypoints[1].Value
        end)
        numVal.Value = startVal

        local tween = TweenService:Create(
            numVal,
            TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Value = 1}
        )

        local connection = numVal.Changed:Connect(function(val)
            if obj and obj.Parent then
                obj.Transparency = NumberSequence.new(val)
            end
        end)

        tween:Play()
        tween.Completed:Connect(function()
            connection:Disconnect()
            numVal:Destroy()
            if obj and obj.Parent then
                obj.Enabled = false
            end
        end)
    elseif obj:IsA("Light") then
        TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Brightness = 0}):Play()
        task.delay(duration, function()
            if obj and obj.Parent then obj.Enabled = false end
        end)
    elseif obj:IsA("Sound") then
        TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Volume = 0}):Play()
    elseif obj:IsA("BasePart") then
        TweenService:Create(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
    end
end

local function fadeOutFXByName(model, targetName, duration)
    for _, obj in ipairs(model:GetDescendants()) do
        if obj.Name == targetName then
            fadeOutFX(obj, duration)
        end
    end
end

-- XỬ LÝ KHI THỰC THỂ DÍNH THÁNH GIÁ
local function banishEntity(entity)
    processedEntities[entity] = true
    hasBeenUsed = true -- Đánh dấu thánh giá đã được sử dụng (chỉ dùng 1 lần)

    -- Phát tín hiệu nếu là ReboundChild bị trị
    if entity.Name == "ReboundChild" then
        setReboundBanishedSignal(true)
    end

    -- Fade out UI Nút bấm ngay lập tức khi kích hoạt dùng thánh giá
    task.spawn(function()
        toggleButton.Active = false
        local fadeInfo = TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(buttonFrame, fadeInfo, {ImageTransparency = 1}):Play()
        TweenService:Create(toggleButton, fadeInfo, {ImageTransparency = 1}):Play()
    end)

    shakeCameraImpact()
    triggerVipPurpleFlash()

    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if crucifixModel then
        crucifixModel:Destroy()
        crucifixModel = nil
    end

    local usedCrucifix = nil
    local successCrucifix, loadedCrucifixes = pcall(function()
        return game:GetObjects("rbxassetid://" .. FLYING_CRUCIFIX_ASSET_ID)
    end)
    if successCrucifix and loadedCrucifixes and #loadedCrucifixes > 0 then
        usedCrucifix = loadedCrucifixes[1]
        usedCrucifix.Name = "BanishingCrucifix"
    end

    isEquipped = false
    targetAlpha = 0
    setCrucifixSignal(false)

    local existingSound = entity:FindFirstChild("CrucifixEntitySound", true)
    local frozenCFrame = entity:GetPivot()
    for _, v in ipairs(entity:GetDescendants()) do
        if v:IsA("BaseScript") or v:IsA("TouchTransmitter") or v:IsA("BodyMover") or v:IsA("Constraint") then
            v:Destroy()
        elseif v:IsA("BasePart") then
            v.Anchored = true
            v.CanTouch = false
            v.CanQuery = false
            v.CanCollide = false
            v.AssemblyLinearVelocity = Vector3.zero
            v.AssemblyAngularVelocity = Vector3.zero
        elseif v:IsA("Humanoid") then
            v.WalkSpeed = 0
        end
    end

    local hardLockConnection
    hardLockConnection = RunService.RenderStepped:Connect(function()
        if entity and entity.Parent then
            entity:PivotTo(frozenCFrame)
        else
            if hardLockConnection then
                hardLockConnection:Disconnect()
                hardLockConnection = nil
            end
        end
    end)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {entity, localPlayer.Character}
    local rayResult = workspace:Raycast(frozenCFrame.Position + Vector3.new(0, 5, 0), Vector3.new(0, -100, 0), raycastParams)
    local floorPosition = rayResult and rayResult.Position or frozenCFrame.Position
    local lockedCFrame = CFrame.new(floorPosition + Vector3.new(0, FLOOR_OFFSET, 0)) * (frozenCFrame - frozenCFrame.Position)
    
    local success1, effectObjs = pcall(function()
        return game:GetObjects("rbxassetid://" .. EFFECT_MODEL_ASSET_ID)
    end)
    
    -- TẢI MODEL BỊ THÁNH GIÁ PHÙ HỢP TỪNG THỰC THỂ
    local entityConfig = TARGET_ENTITIES[entity.Name]
    local entityEffectAssetId = entityConfig and entityConfig.EffectId or RIPE_EFFECT_ASSET_ID
    local success2, entityObjs = pcall(function()
        return game:GetObjects("rbxassetid://" .. entityEffectAssetId)
    end)

    local spinConn = nil
    local crucifixLight = nil
    local beam, att0, att1 = nil, nil, nil

    if usedCrucifix then
        usedCrucifix.Parent = workspace

        pcall(function()
            usedCrucifix:ScaleTo(usedCrucifix:GetScale() * 1.25)
        end)
        local PURPLE_COLOR = Color3.fromRGB(185, 75, 255)

        for _, v in ipairs(usedCrucifix:GetDescendants()) do
            if v:IsA("WeldConstraint") or v:IsA("Weld") or v:IsA("Motor6D") then
                v:Destroy()
            elseif v:IsA("BasePart") then
                v.Anchored = true
                v.CanCollide = false
                v.Material = Enum.Material.Neon
                v.Color = PURPLE_COLOR
                v.Transparency = 0
                v.LocalTransparencyModifier = 0
            end
        end

        local crucifixHandle = usedCrucifix.PrimaryPart or usedCrucifix:FindFirstChildWhichIsA("BasePart")
        if crucifixHandle then
            crucifixLight = Instance.new("PointLight")
            crucifixLight.Name = "CrucifixPurpleLight"
            crucifixLight.Color = PURPLE_COLOR
            -- POINTLIGHT XOAY SÁNG GẤP ĐÔI (6)
            crucifixLight.Brightness = 6
            crucifixLight.Range = 18
            crucifixLight.Shadows = true
            crucifixLight.Parent = crucifixHandle

            -- TẠO TIA NĂNG LƯỢNG KẾT NỐI ĐẾN THỰC THỂ
            local targetPartForBeam = entity.PrimaryPart or entity:FindFirstChildWhichIsA("BasePart")
            if targetPartForBeam then
                att0 = Instance.new("Attachment", crucifixHandle)
                att1 = Instance.new("Attachment", targetPartForBeam)

                beam = Instance.new("Beam")
                beam.Name = "CrucifixSoulBeam"
                beam.Attachment0 = att0
                beam.Attachment1 = att1
                beam.Color = ColorSequence.new(Color3.fromRGB(220, 130, 255), Color3.fromRGB(160, 60, 255))
                beam.Width0 = 1.2
                beam.Width1 = 2.8
                beam.Texture = "rbxassetid://1251850731"
                beam.TextureSpeed = 3.5
                beam.FaceCamera = true
                beam.Transparency = NumberSequence.new(0.15)
                beam.Parent = crucifixHandle
            end
        end

        local lookDir = hrp and hrp.CFrame.LookVector or Vector3.new(0, 0, -1)
        local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
        if flatLook.Magnitude == 0 then
            flatLook = Vector3.new(0, 0, -1)
        else
            flatLook = flatLook.Unit
        end

        local startPos = hrp and (hrp.CFrame * CFrame.new(0, 0.5, -1.5)).Position or frozenCFrame.Position
        local targetPos = (hrp and hrp.CFrame or frozenCFrame) * CFrame.new(0, 5, -10).Position

        -- HIỆU ỨNG XOAY TỪ CHẬM ĐẾN SIÊU NHANH GIA TỐC (MAX 1200 VÒNG/S)
        task.spawn(function()
            local startTime = tick()
            local flyDuration = 0.5
            local currentYaw = 0
            local currentSpeed = 360
            local maxSpeed = 1200 * 360
            local acceleration = 800000

            spinConn = RunService.RenderStepped:Connect(function(dt)
                if usedCrucifix and usedCrucifix.Parent then
                    local elapsed = tick() - startTime
                    local alpha = math.min(1, elapsed / flyDuration)
                    local easedAlpha = 1 - (1 - alpha) * (1 - alpha)
                    local currentPos = startPos:Lerp(targetPos, easedAlpha)
                    
                    currentSpeed = math.min(maxSpeed, currentSpeed + acceleration * dt)
                    currentYaw = (currentYaw + currentSpeed * dt) % 360
                    
                    local baseUprightCFrame = CFrame.lookAt(currentPos, currentPos + flatLook, Vector3.yAxis)
                    usedCrucifix:PivotTo(baseUprightCFrame * CFrame.Angles(0, math.rad(currentYaw), 0))

                    if crucifixLight then
                        crucifixLight.Brightness = 6 + math.sin(tick() * 18) * 3
                    end
                end
            end)
        end)
    end

    task.delay(0.12, function()
        if hardLockConnection then
            hardLockConnection:Disconnect()
            hardLockConnection = nil
        end
        if entity and entity.Parent then
            entity:Destroy()
        end
    end)
    if success1 and effectObjs and #effectObjs > 0 then
        local effectModel = effectObjs[1]
        effectModel.Name = "CrucifixEffectModel"
        effectModel:PivotTo(lockedCFrame)
        effectModel.Parent = workspace

        local thucthePart = effectModel:FindFirstChild("thucthe", true)

        -- TẢI POINT LIGHT CỦA HIỆU ỨNG THÁNH GIÁ
        local effectLight = effectModel:FindFirstChildWhichIsA("PointLight", true)
        if not effectLight then
            effectLight = Instance.new("PointLight")
            effectLight.Name = "CrucifixEffectLight"
            effectLight.Color = Color3.fromRGB(185, 75, 255)
            effectLight.Shadows = true
            effectLight.Parent = thucthePart or effectModel.PrimaryPart or effectModel:FindFirstChildWhichIsA("BasePart")
        end
        effectLight.Enabled = true
        effectLight.Brightness = 0
        effectLight.Range = 0

        for _, obj in ipairs(effectModel:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Anchored = true
                obj.CanTouch = false
                obj.CanQuery = false
                obj.CanCollide = false
            end
        end
        local replacementModel = nil
        if success2 and entityObjs and #entityObjs > 0 then
            replacementModel = entityObjs[1]
            replacementModel.Name = entity.Name .. "_Replacement"
            if thucthePart and thucthePart:IsA("BasePart") then
                replacementModel:PivotTo(thucthePart.CFrame)
                replacementModel.Parent = thucthePart
                for _, part in ipairs(replacementModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = false
                        part.CanTouch = false
                        part.CanQuery = false
                        part.CanCollide = false
                        local weld = Instance.new("WeldConstraint")
                        weld.Part0 = thucthePart
                        weld.Part1 = part
                        weld.Parent = part
                    end
                end
            else
                replacementModel:PivotTo(lockedCFrame)
                replacementModel.Parent = effectModel
                for _, part in ipairs(replacementModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = true
                        part.CanTouch = false
                        part.CanQuery = false
                        part.CanCollide = false
                    end
                end
            end
        end

        local soundParent = thucthePart or effectModel.PrimaryPart or effectModel:FindFirstChildWhichIsA("BasePart")
        if soundParent then
            if existingSound and existingSound:IsA("Sound") then
                existingSound.Parent = soundParent
                if not existingSound.IsPlaying then
                    existingSound:Play()
                end
            else
                task.spawn(function()
                    local soundOk, soundAsset = pcall(function()
                        return GitAud(ENTITY_SOUND_URL, ENTITY_SOUND_NAME)
                    end)
                    if soundOk and soundAsset then
                        local entitySound = Instance.new("Sound")
                        entitySound.Name = "CrucifixEntitySound"
                        entitySound.SoundId = soundAsset
                        entitySound.Volume = 2.5
                        entitySound.RollOffMinDistance = 50
                        entitySound.RollOffMaxDistance = 120
                        entitySound.RollOffMode = Enum.RollOffMode.Inverse
                        entitySound.Parent = soundParent
                        entitySound:Play()
                    end
                end)
            end
        end
        task.wait(2.8)
        local hellRumbleHandle = startContinuousShake(5.5, 6.0, 0.7)
        task.wait(0.7) 

        -- HÀM VỠ THÁNH GIÁ: TĂNG KÍCH THƯỚC GẤP 1.5 LẦN & MẢNH VĂNG MƯỢT
        local function triggerCrucifixBreak()
            if usedCrucifix and usedCrucifix.Parent then
                if spinConn then
                    spinConn:Disconnect()
                    spinConn = nil
                end

                pcall(function()
                    usedCrucifix:ScaleTo(usedCrucifix:GetScale() * 1.5)
                end)

                if beam then beam:Destroy() end
                if att0 then att0:Destroy() end
                if att1 then att1:Destroy() end

                task.spawn(function()
                    local soundOk, soundAsset = pcall(function()
                        return GitAud(BREAK_SOUND_URL, BREAK_SOUND_NAME)
                    end)
                    if soundOk and soundAsset then
                        local breakSound = Instance.new("Sound")
                        breakSound.Name = "CrucifixBreakSound"
                        breakSound.SoundId = soundAsset
                        breakSound.Volume = 3.0
                        breakSound.RollOffMinDistance = 40
                        breakSound.RollOffMaxDistance = 150
                        breakSound.Parent = usedCrucifix.PrimaryPart or usedCrucifix:FindFirstChildWhichIsA("BasePart") or workspace
                        breakSound:Play()
                    end
                end)

                triggerVipPurpleFlash()
                shakeCameraLightImpact()

                -- POINTLIGHT CỰC ĐẠI KHI VỠ GẤP ĐÔI (32)
                if crucifixLight then
                    TweenService:Create(crucifixLight, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Brightness = 32,
                        Range = 40
                    }):Play()
                end

                local parts = {}
                local fxList = {}

                for _, p in ipairs(usedCrucifix:GetDescendants()) do
                    if p:IsA("BasePart") then
                        table.insert(parts, p)
                        p.Material = Enum.Material.Neon
                        p.Color = Color3.fromRGB(230, 140, 255)
                    elseif p:IsA("ParticleEmitter") or p:IsA("Beam") or p:IsA("Trail") or p:IsA("Light") then
                        table.insert(fxList, p)
                    elseif p:IsA("WeldConstraint") or p:IsA("Weld") or p:IsA("Motor6D") then
                        p:Destroy()
                    end
                end

                local rng = Random.new()
                local disperseDuration = 0.25

                for _, p in ipairs(parts) do
                    p.Anchored = true
                    p.CanCollide = false

                    local offsetDir = Vector3.new(
                        rng:NextNumber(-9, 9),
                        rng:NextNumber(-6, 8),
                        rng:NextNumber(-9, 9)
                    )
                    local targetCFrame = p.CFrame * CFrame.new(offsetDir) * CFrame.Angles(
                        math.rad(rng:NextNumber(-540, 540)),
                        math.rad(rng:NextNumber(-540, 540)),
                        math.rad(rng:NextNumber(-540, 540))
                    )

                    TweenService:Create(p, TweenInfo.new(disperseDuration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        CFrame = targetCFrame
                    }):Play()
                end

                task.wait(disperseDuration * 0.8)

                local maxFadeTime = 0.6
                for _, p in ipairs(parts) do
                    local individualDuration = rng:NextNumber(0.45, 0.6)
                    task.spawn(function()
                        TweenService:Create(p, TweenInfo.new(individualDuration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
                            Transparency = 1
                        }):Play()
                    end)
                end

                for _, fx in ipairs(fxList) do
                    local individualDuration = rng:NextNumber(0.45, 0.6)
                    fadeOutFX(fx, individualDuration)
                end

                if crucifixLight then
                    TweenService:Create(crucifixLight, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Brightness = 0,
                        Range = 0
                    }):Play()
                end

                task.wait(maxFadeTime + 0.1)
                if usedCrucifix and usedCrucifix.Parent then
                    usedCrucifix:Destroy()
                end
            end
        end

        if thucthePart and thucthePart:IsA("BasePart") then
            -- TWEEN POINT LIGHT SÁNG GẤP ĐÔI (30) TRONG 1 GIÂY KHI THỰC THỂ BẮT ĐẦU KÉO LÊN
            if effectLight then
                TweenService:Create(
                    effectLight,
                    TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {Brightness = 30, Range = 60}
                ):Play()
            end

            local startCFrame = thucthePart.CFrame
            local upCFrame = startCFrame * CFrame.new(0, 4.5, 0)
            local downCFrame = upCFrame * CFrame.new(0, -35, 0)
            local tween1 = TweenService:Create(
                thucthePart,
                TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
                {CFrame = upCFrame}
            )
            tween1:Play()
            tween1.Completed:Wait()
            stopContinuousShake(hellRumbleHandle, 0.2)
            shakeCameraHellImpact() 

            for _, obj in ipairs(effectModel:GetDescendants()) do
                local isEntityPart = (replacementModel and (obj == replacementModel or obj:IsDescendantOf(replacementModel)))
                if not isEntityPart then
                    local name = obj.Name
                    if name ~= "1" and name ~= "2" and name ~= "3" and name ~= "4" then
                        fadeOutFX(obj, 1.2)
                    end
                end
            end

            local tween2 = TweenService:Create(
                thucthePart,
                TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {CFrame = downCFrame}
            )
            tween2:Play()
            tween2.Completed:Wait()

            if effectLight then
                TweenService:Create(
                    effectLight,
                    TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {Brightness = 0, Range = 0}
                ):Play()
            end

            task.spawn(triggerCrucifixBreak)
        else
            if effectLight then
                TweenService:Create(
                    effectLight,
                    TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {Brightness = 30, Range = 60}
                ):Play()
            end

            local upCFrame = lockedCFrame * CFrame.new(0, 4.5, 0)
            tweenModel(effectModel, upCFrame, 0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            stopContinuousShake(hellRumbleHandle, 0.2)
            shakeCameraHellImpact()

            for _, obj in ipairs(effectModel:GetDescendants()) do
                local isEntityPart = (replacementModel and (obj == replacementModel or obj:IsDescendantOf(replacementModel)))
                if not isEntityPart then
                    local name = obj.Name
                    if name ~= "1" and name ~= "2" and name ~= "3" and name ~= "4" then
                        fadeOutFX(obj, 1.2)
                    end
                end
            end

            local downCFrame = upCFrame * CFrame.new(0, -35, 0)
            tweenModel(effectModel, downCFrame, 1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

            if effectLight then
                TweenService:Create(
                    effectLight,
                    TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    {Brightness = 0, Range = 0}
                ):Play()
            end

            task.spawn(triggerCrucifixBreak)
        end

        task.wait(1)
        fadeOutFXByName(effectModel, "4", 0.8)
        task.wait(1)
        fadeOutFXByName(effectModel, "3", 0.8)
        task.wait(1)
        fadeOutFXByName(effectModel, "2", 0.8)
        task.wait(2)
        fadeOutFXByName(effectModel, "1", 0.8)
        task.wait(1.5)
        if effectModel and effectModel.Parent then
            effectModel:Destroy()
        end
        if screenGui and screenGui.Parent then
            screenGui:Destroy()
        end
    end
end

-- VÒNG LẶP QUÉT CÁC THỰC THỂ MỤC TIÊU
local function startEntityDetection()
    if entityCheckConnection then return end
    entityCheckConnection = RunService.RenderStepped:Connect(function()
        if not isEquipped or currentAlpha < 0.3 or hasBeenUsed then return end
        local character = localPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart
        for _, child in ipairs(workspace:GetDescendants()) do
            if child:IsA("Model") and TARGET_ENTITIES[child.Name] and not processedEntities[child] then
                local config = TARGET_ENTITIES[child.Name]
                local soundRange = config.SoundRange or DEFAULT_SOUND_RANGE
                local banishRange = config.BanishRange or DEFAULT_BANISH_RANGE

                local primary = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                if primary then
                    local distance = (hrp.Position - primary.Position).Magnitude
                    if distance <= soundRange and not soundPlayedEntities[child] then
                        soundPlayedEntities[child] = true
                        task.spawn(function()
                            local soundOk, soundAsset = pcall(function()
                                return GitAud(ENTITY_SOUND_URL, ENTITY_SOUND_NAME)
                            end)
                            if soundOk and soundAsset and child and child.Parent then
                                local targetPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")
                                if targetPart then
                                    local entitySound = Instance.new("Sound")
                                    entitySound.Name = "CrucifixEntitySound"
                                    entitySound.SoundId = soundAsset
                                    entitySound.Volume = 2.5
                                    entitySound.RollOffMinDistance = 50
                                    entitySound.RollOffMaxDistance = 120
                                    entitySound.RollOffMode = Enum.RollOffMode.Inverse
                                    entitySound.Parent = targetPart
                                    entitySound:Play()
                                end
                            end
                        end)
                    end
                    if distance <= banishRange and not hasBeenUsed then
                        task.spawn(function()
                            banishEntity(child)
                        end)
                    end
                end
            end
        end
    end)
end

local function stopEntityDetection()
    if entityCheckConnection then
        entityCheckConnection:Disconnect()
        entityCheckConnection = nil
    end
end

-- ANIMATION GIƠ TAY
local function startAnimationLoop()
    if shoulderConnection then return end
    shoulderConnection = RunService.Stepped:Connect(function(_, deltaTime)
        local character = localPlayer.Character
        if not character then return end
        local rightUpperArm = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
        local shoulder = rightUpperArm and (rightUpperArm:FindFirstChild("RightShoulder") or rightUpperArm:FindFirstChild("Shoulder"))
        if targetAlpha > currentAlpha then
            currentAlpha = math.min(1, currentAlpha + deltaTime * ANIM_SPEED)
        elseif targetAlpha < currentAlpha then
            currentAlpha = math.max(0, currentAlpha - deltaTime * ANIM_SPEED)
        end
        if shoulder and currentAlpha > 0 then
            local targetCFrame = CFrame.Angles(math.rad(90), 0, 0)
            shoulder.Transform = shoulder.Transform:Lerp(targetCFrame, currentAlpha)
        end
        if currentAlpha <= 0 and not isEquipped then
            if crucifixModel then
                crucifixModel:Destroy()
                crucifixModel = nil
            end
            if shoulderConnection then
                shoulderConnection:Disconnect()
                shoulderConnection = nil
            end
        end
    end)
end

-- TRANG BỊ / CẤT THÁNH GIÁ
local function equipCrucifix()
    if hasBeenUsed then return end
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if not rightHand then return end

    if not crucifixModel then
        local success, objects = pcall(function()
            return game:GetObjects("rbxassetid://" .. CRUCIFIX_ASSET_ID)
        end)

        if not success or not objects or #objects == 0 then
            warn("[Crucifix] Không thể tải Model!")
            return
        end

        crucifixModel = objects[1]
        crucifixModel.Name = "CustomCrucifix"

        local handle = crucifixModel.PrimaryPart or crucifixModel:FindFirstChildWhichIsA("BasePart")
        if not handle then
            for _, v in ipairs(crucifixModel:GetDescendants()) do
                if v:IsA("BasePart") then
                    handle = v
                    break
                end
            end
        end

        if handle then
            crucifixModel.PrimaryPart = handle
            local offsetCFrame = rightHand.CFrame * CFrame.new(0, -0.2, -0.9) * CFrame.Angles(math.rad(-90), 0, 0)
            crucifixModel:PivotTo(offsetCFrame)

            for _, part in ipairs(crucifixModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.LocalTransparencyModifier = 0
                    if part.Transparency >= 1 and part ~= handle then
                        part.Transparency = 0
                    end
                    part.CanCollide = false
                    part.Anchored = false

                    if part ~= handle then
                        local existingWeld = part:FindFirstChildWhichIsA("WeldConstraint") or part:FindFirstChildWhichIsA("Weld")
                        if not existingWeld then
                            local w = Instance.new("WeldConstraint")
                            w.Part0 = handle
                            w.Part1 = part
                            w.Parent = part
                        end
                    end
                end
            end

            local handWeld = Instance.new("WeldConstraint")
            handWeld.Name = "HandWeld"
            handWeld.Part0 = rightHand
            handWeld.Part1 = handle
            handWeld.Parent = handle
        end

        crucifixModel.Parent = character
    end

    targetAlpha = 1
    setCrucifixSignal(true)
    startAnimationLoop()
    startEntityDetection()
end

local function unequipCrucifix()
    targetAlpha = 0
    setCrucifixSignal(false)
    stopEntityDetection()
end

toggleButton.MouseButton1Click:Connect(function()
    if hasBeenUsed then return end
    isEquipped = not isEquipped

    if isEquipped then
        equipCrucifix()
    else
        unequipCrucifix()
    end
end)
