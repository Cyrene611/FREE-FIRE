function GitAud(soundgit, filename, extension, parent) 
	extension = extension or "mp3" 
	local Path = filename .. "." .. extension 
	if not isfile(Path) then 
		writefile(Path, game:HttpGet(soundgit)) 
	end 
	local Sound = Instance.new("Sound") 
	Sound.Name = filename 
	Sound.SoundId = getcustomasset(Path) 
	Sound.Parent = parent 
	return Sound 
end

