-- 10. AUTO-SYNC MÀU & HIỆU ỨNG ĐÈN NEON
-- ----------------------------------------------------------------------------
task.spawn(function()
    local DEFAULT_MODEL_ID = "rbxassetid://97667155562465"
    local ALT_MODEL_ID     = "rbxassetid://118890612722672"

    local function isMultipleOf90(angleDeg, tol)
        local mod = math.abs(angleDeg) % 90
        return (mod <= tol) or (mod >= (90 - tol))
    end

    local function isDiagonalNeon(object)
        if object.Name ~= "Neon" then 
            return false 
        end
        
        local rot = object.Orientation
        local tol = 5
        
        local xAligned = isMultipleOf90(rot.X, tol)
        local yAligned = isMultipleOf90(rot.Y, tol)
        local zAligned = isMultipleOf90(rot.Z, tol)
        
        return not (xAligned and yAligned and zAligned)
    end

    local function updateModelColor(mainModel, targetColor)
        for _, child in pairs(mainModel:GetDescendants()) do
            if child:IsA("ParticleEmitter") then
                child.Color = ColorSequence.new(targetColor)
            elseif child:IsA("BasePart") or child:IsA("MeshPart") then
                child.Color = targetColor
            end
        end
    end

    local function checkAndSpawn(object)
        local successPath, path = pcall(function() return object:GetFullName() end)
        if not successPath or not path then return end
        
        if path:find("%.Lights%.Neon") or path:find("%.Lights%.SmallNeon") or path:find("%.Lights%.Nec") then
            if not object:FindFirstChild("ModelSpawned") then
                local marker = Instance.new("BoolValue")
                marker.Name = "ModelSpawned"
                marker.Parent = object
                
                local modelToUse = DEFAULT_MODEL_ID
                if isDiagonalNeon(object) then
                    modelToUse = ALT_MODEL_ID
                end
                
                task.spawn(function()
                    local objects
                    local success = pcall(function()
                        objects = game:GetObjects(modelToUse)
                    end)
                    
                    if not success or not objects or #objects == 0 then return end
                    
                    local mainModel = objects[1]
                    local neonCFrame = object.CFrame
                    
                    if mainModel:IsA("BasePart") then
                        mainModel.CFrame = neonCFrame
                    elseif mainModel:IsA("Model") then
                        mainModel:PivotTo(neonCFrame)
                    end
                    
                    updateModelColor(mainModel, object.Color)
                    mainModel.Parent = workspace
                    
                    local disableThread = nil
                    
                    local function checkNeonState()
                        local isNeon = (object.Material == Enum.Material.Neon) and (object.Transparency < 1)
                        
                        if isNeon then
                            if disableThread then
                                task.cancel(disableThread)
                                disableThread = nil
                            end
                            updateModelColor(mainModel, object.Color)
                            if mainModel.Parent ~= workspace then
                                mainModel.Parent = workspace
                            end
                        else
                            if not disableThread then
                                disableThread = task.delay(0.35, function()
                                    local stillNotNeon = (object.Material ~= Enum.Material.Neon) or (object.Transparency >= 1)
                                    if stillNotNeon then
                                        mainModel.Parent = nil
                                    end
                                    disableThread = nil
                                end)
                            end
                        end
                    end
                    
                    object:GetPropertyChangedSignal("Material"):Connect(checkNeonState)
                    object:GetPropertyChangedSignal("Transparency"):Connect(checkNeonState)
                    object:GetPropertyChangedSignal("Color"):Connect(function()
                        if object.Material == Enum.Material.Neon then
                            updateModelColor(mainModel, object.Color)
                        end
                    end)
                    
                    object.AncestryChanged:Connect(function(_, parent)
                        if not parent then
                            mainModel:Destroy()
                        end
                    end)
                    
                    checkNeonState()
                end)
            end
        end
    end

    local allObjects = workspace:GetDescendants()
    for i = 1, #allObjects do
        local object = allObjects[i]
        if object and object:IsA("BasePart") then
            checkAndSpawn(object)
        end
        if i % 100 == 0 then task.wait() end 
    end

    workspace.DescendantAdded:Connect(function(object)
        if object:IsA("BasePart") then
            task.defer(checkAndSpawn, object)
        end
    end)
end)

