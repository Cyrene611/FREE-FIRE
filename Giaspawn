local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Load Module Interactions.Base chuẩn Pressure
local InteractionsBase = require(ReplicatedStorage:WaitForChild("Interactions"):WaitForChild("Base"))

local localPlayer = Players.LocalPlayer
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- ======= HÀM HIỂN THỊ PHỤ ĐỀ CHUẨN PRESSURE =======
local function Subtitle(text, duration)
    duration = duration or 3
    
    local success = pcall(function()
        local SubtitlesModule = require(localPlayer.PlayerGui.Main.Client.MainClient.SubTitles)
        SubtitlesModule.new(text, duration, 100, false):Show()
    end)
    
    if not success then
        local remote = ReplicatedStorage:FindFirstChild("SubTitles", true) or ReplicatedStorage:FindFirstChild("Subtitle", true)
        if remote then
            local conn = getconnections and getconnections(remote.OnClientEvent)[1]
            if conn and conn.Function then
                pcall(conn.Function, text, duration, 100, false)
            end
        end
    end
end

-- 1. Tìm spawn point (DrawerSpawn / DeskSpawn) trong phòng hiện tại
local function getSpawnInCurrentRoom()
    local gameplayFolder = Workspace:FindFirstChild("GameplayFolder")
    local roomsFolder = gameplayFolder and gameplayFolder:FindFirstChild("Rooms")
    
    if not roomsFolder then
        warn("Không tìm thấy 'GameplayFolder.Rooms'!")
        return nil
    end

    local playerPos = hrp.Position
    local currentRoom = nil
    local shortestDist = math.huge

    for _, room in ipairs(roomsFolder:GetChildren()) do
        if room:IsA("Model") then
            local roomCFrame = room:GetBoundingBox()
            local dist = (roomCFrame.Position - playerPos).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                currentRoom = room
            end
        end
    end

    if not currentRoom then return nil end

    local candidateSpawns = {}
    for _, obj in ipairs(currentRoom:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "DrawerSpawn" or obj.Name == "DeskSpawn") then
            table.insert(candidateSpawns, obj)
        end
    end

    -- Nếu phòng hiện tại không có spawn, quét toàn bộ các phòng khác
    if #candidateSpawns == 0 then
        for _, room in ipairs(roomsFolder:GetChildren()) do
            for _, obj in ipairs(room:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "DrawerSpawn" or obj.Name == "DeskSpawn") then
                    table.insert(candidateSpawns, obj)
                end
            end
        end
    end

    if #candidateSpawns == 0 then return nil end
    return candidateSpawns[math.random(1, #candidateSpawns)]
end

local chosenSpawn = getSpawnInCurrentRoom()
if not chosenSpawn then
    warn("Không tìm thấy DrawerSpawn hoặc DeskSpawn nào!")
    return
end

-- 2. Load Model bằng game:GetObjects
local modelId = "113179121672519"
local objects = game:GetObjects("rbxassetid://" .. modelId)
local rawObject = objects and objects[1]

if not rawObject then
    warn("Không load được Model!")
    return
end

local model
if rawObject:IsA("Model") then
    model = rawObject
else
    model = Instance.new("Model")
    rawObject.Parent = model
end

model.Parent = Workspace

local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
if not primaryPart then return end
model.PrimaryPart = primaryPart

-- Tối ưu Physics & Weld các part phụ
for _, part in ipairs(model:GetDescendants()) do
    if part:IsA("BasePart") then
        part.CanCollide = false
        part.Anchored = false
        if part ~= primaryPart then
            local innerWeld = Instance.new("WeldConstraint")
            innerWeld.Part0 = primaryPart
            innerWeld.Part1 = part
            innerWeld.Parent = primaryPart
        end
    end
end

-- Đèn tím
local light1 = Instance.new("PointLight")
light1.Color = Color3.fromRGB(170, 0, 255)
light1.Brightness = 3
light1.Range = 15
light1.Shadows = false
light1.Parent = primaryPart

local light2 = Instance.new("PointLight")
light2.Color = Color3.fromRGB(170, 0, 255)
light2.Brightness = 99
light2.Range = 1.5
light2.Parent = primaryPart

-- 3. Xử lý vị trí & Weld
local connection
if chosenSpawn.Name == "DrawerSpawn" then
    -- Nằm xuống
    model:PivotTo(chosenSpawn.CFrame * CFrame.Angles(math.rad(-90), 0, 0))

    local spawnWeld = Instance.new("WeldConstraint")
    spawnWeld.Part0 = chosenSpawn
    spawnWeld.Part1 = primaryPart
    spawnWeld.Parent = primaryPart

elseif chosenSpawn.Name == "DeskSpawn" then
    -- Cao hơn 1.8 studs, xoay & dập dềnh
    local heightOffset = 1.8
    local baseOffsetCFrame = CFrame.new(0, heightOffset, 0)
    
    model:PivotTo(chosenSpawn.CFrame * baseOffsetCFrame)

    local spawnWeld = Instance.new("Weld")
    spawnWeld.Part0 = chosenSpawn
    spawnWeld.Part1 = primaryPart
    spawnWeld.C0 = baseOffsetCFrame
    spawnWeld.C1 = CFrame.new()
    spawnWeld.Parent = primaryPart

    local timeElapsed = 0
    local floatSpeed = 3
    local floatHeight = 0.35
    local spinSpeed = 30

    connection = RunService.Heartbeat:Connect(function(dt)
        if not model or not model.Parent or not spawnWeld or not spawnWeld.Parent then
            if connection then connection:Disconnect() end
            return
        end

        timeElapsed = timeElapsed + dt
        local yOffset = heightOffset + math.sin(timeElapsed * floatSpeed) * floatHeight
        local rotation = math.rad(timeElapsed * spinSpeed)

        spawnWeld.C0 = CFrame.new(0, yOffset, 0) * CFrame.Angles(0, rotation, 0)
    end)
end

