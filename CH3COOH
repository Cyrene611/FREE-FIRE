                    if not isProxCooldown then
                        isProxCooldown = true
                        if damageRemote and damageRemote:IsA("RemoteEvent") then
                            damageRemote:FireServer(24, "SittingItOut", 1, nil)
                            damageRemote:FireServer("Damage", 24)
                        end

                        -- Gắn hiệu ứng điện cho người chơi (Tồn tại 4.5 giây)
                        if playerRoot then
                            local oldParticle = playerRoot:FindFirstChild("PlayerElectricEffect")
                            if oldParticle then
                                oldParticle:Destroy()
                            end
                            local playerElectric = createElectricParticle()
                            playerElectric.Name = "PlayerElectricEffect"
                            playerElectric.Parent = playerRoot
                            Debris:AddItem(playerElectric, 4.5)
                        end

                        task.spawn(function()
                            task.wait(0.65)
                            isProxCooldown = false
                        end)
                    end
                end

                -- C. CHẠM VÀO VẬT THỂ ĐANG BỊ NHIỄM ĐIỆN (MẤT 1 HP / 0.5S)
                if touchingElectrifiedPart then
                    if not isTouchElectricCooldown then
                        isTouchElectricCooldown = true
                        
                        local isSafeInLocker = false
                        if Rooms then
                            for _, descendant in ipairs(Rooms:GetDescendants()) do
                                if descendant:IsA("Model") and descendant.Name == "Locker" then
                                    local playerInValue = descendant:FindFirstChild("PlayerIn", true)
                                    if playerInValue and playerInValue.Value == true then
                                        isSafeInLocker = true
                                        break
                                    end
                                end
                            end
                        end

                        if not isSafeInLocker then
                            if damageRemote and damageRemote:IsA("RemoteEvent") then
                                damageRemote:FireServer(1, "SittingItOut", 1, nil)
                                damageRemote:FireServer("Damage", 1)
                            end
                        end

                        task.spawn(function()
                            task.wait(0.5)
                            isTouchElectricCooldown = false
                        end)
                    end
                end

                -- D. SÁT THƯƠNG DẪN ĐIỆN BÁN KÍNH 55 STUDS
                if distance <= ELECTRIC_RADIUS then
                    if isCooldown then return end
                    
                    local isSafeInLocker = false
                    if Rooms then
                        for _, descendant in ipairs(Rooms:GetDescendants()) do
                            if descendant:IsA("Model") and descendant.Name == "Locker" then
                                local playerInValue = descendant:FindFirstChild("PlayerIn", true)
                                if playerInValue and playerInValue.Value == true then
                                    isSafeInLocker = true
                                    break
                                end
                            end
                        end
                    end
                    
                    if isSafeInLocker then
