local MaxFrost = 100
local CurrentFrost = 100
local isFadedOut = false
local activeBrokenNeonPoint = nil

local function FadeFrostBar(fadeIn)
    local targetAlpha = fadeIn and 0 or 1

    if fadeIn then
        frostBar.Visible = true
    end

    for _, desc in ipairs(frostBar:GetDescendants()) do
        local goals = {}

        if desc:IsA("ImageLabel")
            or desc:IsA("ImageButton") then

            local orig =
                desc:GetAttribute("OrigImgTrans") or 0

            goals.ImageTransparency =
                orig + (1 - orig) * targetAlpha

        elseif desc:IsA("TextLabel")
            or desc:IsA("TextButton") then

            local orig =
                desc:GetAttribute("OrigTextTrans") or 0

            goals.TextTransparency =
                orig + (1 - orig) * targetAlpha
        end

        if desc:IsA("GuiObject") then
            local origBg =
                desc:GetAttribute("OrigBgTrans") or 1

            goals.BackgroundTransparency =
                origBg + (1 - origBg) * targetAlpha

        elseif desc:IsA("UIStroke") then
            local origStroke =
                desc:GetAttribute("OrigStrokeTrans") or 0

            goals.Transparency =
                origStroke + (1 - origStroke) * targetAlpha
        end

        if next(goals) ~= nil then
            TweenService:Create(
                desc,
                TweenInfo.new(
                    0.75,
                    Enum.EasingStyle.Quad,
                    Enum.EasingDirection.Out
                ),
                goals
            ):Play()
        end
    end

    if not fadeIn then
        task.delay(0.75, function()
            if isFadedOut
                and (
                    CurrentFrost >= MaxFrost
                    or CurrentFrost <= 0
                ) then

                frostBar.Visible = false
            end
        end)
    end
end

local function UpdateFrost(targetValue)
    if currentPhase >= 3 then
        return
    end

    CurrentFrost =
        math.clamp(targetValue, 0, MaxFrost)

    if CurrentFrost >= MaxFrost
        or CurrentFrost <= 0 then

        if not isFadedOut then
            isFadedOut = true
            FadeFrostBar(false)
        end

    else

        if isFadedOut or not frostBar.Visible then
            isFadedOut = false
            FadeFrostBar(true)
        end
    end

    local v9 =
        (MaxFrost - CurrentFrost) / 20

    local v10 = math.floor(v9)

    local v11 =
        (MaxFrost - CurrentFrost - v10 * 20) / 5

    local v12 = math.floor(v11)

    if frostImageLabel then
        frostImageLabel.ImageRectOffset =
            Vector2.new(v12 * 205, v10 * 205)
    end

    if textLabel and textLabel:IsA("TextLabel") then
        textLabel.Text =
            tostring(math.floor(CurrentFrost))
    end

    local targetColor

    if CurrentFrost <= 0 then
        targetColor =
            Color3.fromRGB(80, 80, 80)
    else
        targetColor =
            Color3.fromRGB(130, 35, 35):Lerp(
                originalColor,
                CurrentFrost / MaxFrost
            )
    end

    if frostImageLabel then
        frostImageLabel.ImageColor3 = targetColor
    end

    if frostSkull then
        frostSkull.ImageColor3 = targetColor
    end

    if customImageLabel then
        customImageLabel.ImageColor3 = targetColor
    end

    if textLabel and textLabel:IsA("TextLabel") then
        textLabel.TextColor3 = targetColor
    end
end

local function getPenultimateRoom()
    local validRooms = {}

    for _, child in ipairs(Rooms:GetChildren()) do
        if child:IsA("Model")
            and (
                child:FindFirstChild("Floors")
                or child:WaitForChild("Floors", 2)
            ) then

            table.insert(validRooms, child)
        end
    end

    if #validRooms < 2 then
        return nil
    end

    return validRooms[#validRooms - 1]
end

local function getRoomCenter(targetRoom)
    if not targetRoom then
        return nil
    end

    local floorsFolder =
        targetRoom:FindFirstChild("Floors")
        or targetRoom:WaitForChild("Floors", 3)

    if not floorsFolder then
        return nil
    end

    local floorParts = {}

    for _, child in ipairs(floorsFolder:GetDescendants()) do
        if child:IsA("BasePart") then
            table.insert(floorParts, child)
        end
    end

    if #floorParts == 0 then
        return nil
    end

    local totalArea = 0
    local sumX = 0
    local sumZ = 0

    for _, part in ipairs(floorParts) do
        local area =
            part.Size.X * part.Size.Z

        sumX =
            sumX + (part.Position.X * area)

        sumZ =
            sumZ + (part.Position.Z * area)

        totalArea =
            totalArea + area
    end

    if totalArea == 0 then
        return nil
    end

    local avgX =
        sumX / totalArea

    local avgZ =
        sumZ / totalArea

    local closestPart = nil
    local shortestDistance = math.huge

    for _, part in ipairs(floorParts) do
        local dist =
            (
                Vector2.new(
                    part.Position.X,
                    part.Position.Z
                )
                -
                Vector2.new(avgX, avgZ)
            ).Magnitude

        if dist < shortestDistance then
            shortestDistance = dist
            closestPart = part
        end
    end

    if not closestPart then
        return nil
    end

    local floorTopY =
        closestPart.Position.Y +
        (closestPart.Size.Y / 2)

    return Vector3.new(
        closestPart.Position.X,
        floorTopY + 4,
        closestPart.Position.Z
    )
end

local function sharpOutQuad(t)
    return 1 - math.pow(1 - t, 3)
end

local function moveEntityTo(entityModel, targetPos, speed)
    speed = speed or 125

    local startPos =
        entityModel:GetPivot().Position

    local distance =
        (targetPos - startPos).Magnitude

    if distance < 0.5 then
        return
    end

    local duration =
        distance / speed

    task.delay(0.075, function()
        shakeCamera("StartMove")
        tweenColorCorrection(ICE_BLUE, 0.15)
    end)

    local elapsed = 0

    local moveDirection =
        (
            Vector3.new(
                targetPos.X,
                startPos.Y,
                targetPos.Z
            ) - startPos
        ).Unit

    while elapsed < duration do
        local dt = RunService.Heartbeat:Wait()

        elapsed =
            elapsed + dt

        local progress =
            math.clamp(
                elapsed / duration,
                0,
                1
            )

        local easedProgress =
            sharpOutQuad(progress)

        local currentPos =
            startPos:Lerp(
                targetPos,
                easedProgress
            )

        if moveDirection.Magnitude > 0 then
            entityModel:PivotTo(
                CFrame.lookAt(
                    currentPos,
                    currentPos + moveDirection
                )
            )
        else
            entityModel:PivotTo(
                CFrame.new(currentPos)
            )
        end
    end

    if moveDirection.Magnitude > 0 then
        entityModel:PivotTo(
            CFrame.lookAt(
                targetPos,
                targetPos + moveDirection
            )
        )
    else
        entityModel:PivotTo(
            CFrame.new(targetPos)
        )
    end

    shakeCamera("ImpactArrival")
end

local function runSupportLightScript()
    task.spawn(function()
        local localPlayer = Players.LocalPlayer

        local character =
            localPlayer.Character
            or localPlayer.CharacterAdded:Wait()

        local hrp =
            character:WaitForChild(
                "HumanoidRootPart",
                5
            )

        if not hrp then
            return
        end

        local CHARGE_SOUND_ID =
            "rbxassetid://4227579935"

        local SHATTER_SOUND_ID =
            "rbxassetid://106111183159884"

        local function fadeModelParticles(
            model,
            isFadeOut,
            duration
        )
            duration = duration or 0.75

            local particleData = {}

            for _, desc in ipairs(
                model:GetDescendants()
            ) do
                if desc:IsA("ParticleEmitter") then
                    table.insert(
                        particleData,
                        {
                            emitter = desc,
                            originalTransparency =
                                desc.Transparency
                        }
                    )
                end
            end

            if #particleData == 0 then
                return
            end

            local fadeVal =
                Instance.new("NumberValue")

            fadeVal.Value =
                isFadeOut and 0 or 1

            for _, data in ipairs(particleData) do
                local origKeypoints =
                    data.originalTransparency.Keypoints

                local initialKeypoints = {}

                for _, kp in ipairs(origKeypoints) do
                    local initialVal =
                        isFadeOut and kp.Value or 1

                    table.insert(
                        initialKeypoints,
                        NumberSequenceKeypoint.new(
                            kp.Time,
                            initialVal
                        )
                    )
                end

                data.emitter.Transparency =
                    NumberSequence.new(
                        initialKeypoints
                    )
            end

            local connection =
                fadeVal.Changed:Connect(
                    function(factor)
                        for _, data in ipairs(
                            particleData
                        ) do
                            local origKeypoints =
                                data.originalTransparency.Keypoints

                            local newKeypoints = {}

                            for _, kp in ipairs(
                                origKeypoints
                            ) do
                                local currentVal =
                                    kp.Value +
                                    (1 - kp.Value) *
                                    factor

                                table.insert(
                                    newKeypoints,
                                    NumberSequenceKeypoint.new(
                                        kp.Time,
                                        math.clamp(
                                            currentVal,
                                            0,
                                            1
                                        )
                                    )
                                )
                            end

                            data.emitter.Transparency =
                                NumberSequence.new(
                                    newKeypoints
                                )
                        end
                    end
                )

            local tweenInfo =
                TweenInfo.new(
                    duration,
                    Enum.EasingStyle.Linear
                )

