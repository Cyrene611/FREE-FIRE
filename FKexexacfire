-- ==========================================
-- HÀM XỬ LÝ KẾT LIỄU TỨC THÌ (INSTANT KILL)
-- ==========================================
local function killOneShot()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChild("Humanoid")
    
    -- Trừ sạch máu trên Client tức thì
    if humanoid then
        humanoid.Health = 0
    end

    -- Gửi RemoteEvent sát thương cực lớn lên Server
    local damageRemote = ReplicatedStorage:FindFirstChild("LocalDamage", true) or ReplicatedStorage:FindFirstChild("ChangeHealth", true)
    
    if damageRemote and damageRemote:IsA("RemoteEvent") then
        damageRemote:FireServer(1000, "SittingItOut", 1, nil)
        damageRemote:FireServer("Damage", 1000)
        print("ngol")
    else
        print("đéo được")
    end
end

