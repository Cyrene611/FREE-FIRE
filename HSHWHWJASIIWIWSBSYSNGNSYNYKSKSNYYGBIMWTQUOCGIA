-- Raycast params để bỏ qua character của bản thân
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

-- Hàm lấy máu quét toàn diện (Player -> Folders -> Character)
local function getPlayerHealth(player, char)
    local healthVal = player:FindFirstChild("Health")
    local maxHealthVal = player:FindFirstChild("MaxHealth")

    if not healthVal then
        for _, child in ipairs(player:GetChildren()) do
            if child:IsA("Folder") or child:IsA("Model") then
                if child:FindFirstChild("Health") then
                    healthVal = child:FindFirstChild("Health")
                    maxHealthVal = child:FindFirstChild("MaxHealth") or child:FindFirstChild("MaxHP")
                    break
                end
            end
        end
    end

    if not healthVal and char then
        healthVal = char:FindFirstChild("Health")
        maxHealthVal = char:FindFirstChild("MaxHealth")
    end

    local hp = 100
    local maxHp = 100

    if healthVal and healthVal:IsA("ValueBase") then
        hp = healthVal.Value
    end

    if maxHealthVal and maxHealthVal:IsA("ValueBase") then
        maxHp = maxHealthVal.Value
    elseif char and char:FindFirstChildOfClass("Humanoid") then
        maxHp = char:FindFirstChildOfClass("Humanoid").MaxHealth
        if maxHp <= 0 then maxHp = 100 end
    end

    return hp, maxHp
end

-- Vòng lặp kiểm tra Raycast trực diện mỗi khung hình
RunService.RenderStepped:Connect(function()
    local myChar = localPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

    raycastParams.FilterDescendantsInstances = {myChar}

    local rayResult = Workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 15, raycastParams)
    
    local targetedCharacter = nil
    if rayResult and rayResult.Instance then
        local hitModel = rayResult.Instance:FindFirstAncestorOfClass("Model")
        if hitModel and Players:GetPlayerFromCharacter(hitModel) then
            targetedCharacter = hitModel
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local char = player.Character
            local hl = char:FindFirstChild("TargetHighlight")
            local bb = char:FindFirstChild("TargetInfo")

            if hl and bb then
                if char == targetedCharacter then
                    hl.Enabled = true
                    bb.Enabled = true

                    local nameLbl = bb:FindFirstChild("NameLabel")
                    local userLbl = bb:FindFirstChild("UserLabel")
                    local hpLbl = bb:FindFirstChild("HpLabel")

                    local isOwner = (player.Name == "PressureMode4" or player.DisplayName == "PressureMode4")

                    if nameLbl then
                        if isOwner then
                            nameLbl.Text = "[Owner] " .. player.DisplayName
                        else
                            nameLbl.Text = player.DisplayName
                        end
                    end

                    if userLbl then
                        userLbl.Text = "@" .. player.Name
                    end

                    if hpLbl then
                        local hp, maxHp = getPlayerHealth(player, char)
                        if maxHp <= 0 then maxHp = 100 end
                        local hpPercent = math.clamp(math.floor((hp / maxHp) * 100 + 0.5), 0, 100)
                        hpLbl.Text = string.format("HP: %d%%", hpPercent)
                    end
                else
                    hl.Enabled = false
                    bb.Enabled = false
                end
            end
        end
    end
end)


