local function playBiteEffect(duration)
	duration = duration or 15

	local cc = Lighting:FindFirstChild("BiteColorCorrection") or Instance.new("ColorCorrectionEffect")
	cc.Name = "BiteColorCorrection"
	cc.TintColor = Color3.fromRGB(255, 30, 30)
	cc.Saturation = 0.5
	cc.Contrast = 0.4
	cc.Parent = Lighting

	local bloodGui = PlayerGui:FindFirstChild("BloodEffectGui") or Instance.new("ScreenGui")
	bloodGui.Name = "BloodEffectGui"
	bloodGui.ResetOnSpawn = false
	bloodGui.IgnoreGuiInset = true
	bloodGui.DisplayOrder = 9998
	bloodGui.Parent = PlayerGui

	local bloodImg = bloodGui:FindFirstChild("BloodImg") or Instance.new("ImageLabel")
	bloodImg.Name = "BloodImg"
	bloodImg.AnchorPoint = Vector2.new(0.5, 0.5)
	bloodImg.Position = UDim2.new(0.5, 0, 0.5, 0)
	bloodImg.Size = UDim2.new(1, 0, 1, 0)
	bloodImg.ScaleType = Enum.ScaleType.Stretch
	bloodImg.BackgroundTransparency = 1
	bloodImg.Image = BLOOD_ID
	bloodImg.ImageTransparency = 0.1
	bloodImg.Parent = bloodGui

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	TweenService:Create(cc, tweenInfo, {
		TintColor = Color3.fromRGB(255, 255, 255),
		Saturation = 0,
		Contrast = 0
	}):Play()

	TweenService:Create(bloodImg, tweenInfo, {
		ImageTransparency = 1
	}):Play()

	task.spawn(function()
		local Camera = workspace.CurrentCamera
		local startTime = os.clock()
		local maxRotShake = 3.2
		local maxPosShake = 0.7

		local connection
		connection = RunService.RenderStepped:Connect(function()
			local elapsed = os.clock() - startTime
			if elapsed >= duration then
				if connection then connection:Disconnect() end
				if cc then cc:Destroy() end
				if bloodGui then bloodGui:Destroy() end
				return
			end

			local progress = elapsed / duration
			local intensity = (1 - progress) ^ 2.5

			local rx = math.rad((math.random() * 2 - 1) * maxRotShake * intensity)
			local ry = math.rad((math.random() * 2 - 1) * maxRotShake * intensity)
			local rz = math.rad((math.random() * 2 - 1) * maxRotShake * intensity)

			local px = (math.random() * 2 - 1) * maxPosShake * intensity
			local py = (math.random() * 2 - 1) * maxPosShake * intensity

			Camera.CFrame = Camera.CFrame * CFrame.Angles(rx, ry, rz) * CFrame.new(px, py, 0)
		end)
	end)
end

