local function startContinuousShake(magnitude, roughness, fadeIn)
    if not activeShaker then return nil end
    local inst = {
        ["Magnitude"] = magnitude or 5.5,
        ["Roughness"] = roughness or 6.0,
        ["PositionInfluence"] = Vector3.new(0.35, 0.35, 0.35),
        ["RotationInfluence"] = Vector3.new(3.0, 2.0, 2.0),
        ["roughMod"] = 1,
