local function triggerIntenseSound()
    if not entitySound or not entitySound.Parent then
        return
    end

    if soundTweenVol then
        soundTweenVol:Cancel()
    end

    if soundTweenPitch then
        soundTweenPitch:Cancel()
    end

    local pitchEffect = entitySound:FindFirstChildOfClass("PitchShiftSoundEffect")

    local fadeInTime = 0.22
    local fadeInInfo = TweenInfo.new(
        fadeInTime,
        Enum.EasingStyle.Cubic,
        Enum.EasingDirection.Out
    )

    soundTweenVol = TweenService:Create(
        entitySound,
        fadeInInfo,
        {Volume = 4.0}
    )

    soundTweenVol:Play()

    if pitchEffect then
        soundTweenPitch = TweenService:Create(
            pitchEffect,
            fadeInInfo,
            {Octave = 1.21}
        )

        soundTweenPitch:Play()
    end

    local holdTime = 0.20

    task.delay(fadeInTime + holdTime, function()
        if not entitySound or not entitySound.Parent then
            return
        end

        local fadeOutInfo = TweenInfo.new(
            1.5,
            Enum.EasingStyle.Sine,
            Enum.EasingDirection.Out
        )

        soundTweenVol = TweenService:Create(
            entitySound,
            fadeOutInfo,
            {Volume = 1.88}
        )

        soundTweenVol:Play()

        if pitchEffect then
            soundTweenPitch = TweenService:Create(
                pitchEffect,
                fadeOutInfo,
                {Octave = 1.0}
            )

            soundTweenPitch:Play()
        end
    end)
end

local activeShakeInstances = {}

local function addCameraShake(preset)
    local inst = {
        Magnitude = preset.Magnitude or 1,
        Roughness = preset.Roughness or 16,

        PosInf = preset.PosInf or Vector3.new(0.1, 0.1, 0.1),
        RotInf = preset.RotInf or Vector3.new(0.8, 0.8, 0.8),

        FadeIn = preset.FadeIn or 0,
        SustainTime = preset.SustainTime or 0,
        FadeOut = preset.FadeOut or 0.5,

        timePassed = 0,

        currentAlpha = (preset.FadeIn and preset.FadeIn > 0) and 0 or 1,

        sustainLeft = preset.SustainTime or 0,
        isDone = false,

        isContinuous = preset.Continuous or false,

        targetMagnMult = 0,
        currentMagnMult = 0,

        tick = math.random(-1000, 1000) + math.random()
    }

    table.insert(activeShakeInstances, inst)

    return inst
end

