        if activeHighlights[target] and activeHighlights[target].Parent then
            return
        end

        local highlight = Instance.new("Highlight")
        highlight.Name = "KeyItemHighlight"
        highlight.FillColor = Color3.fromRGB(0, 255, 0)
        highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
        highlight.FillTransparency = 0.35
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = target
        highlight.Parent = target

        activeHighlights[target] = highlight
    end

    local function removeHighlight(target)
        local highlight = activeHighlights[target]

        if highlight then
            if highlight.Parent then
                highlight:Destroy()
            end
            activeHighlights[target] = nil
        end
    end

    while true do
        task.wait(0.15)

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if not hrp then
            continue
        end

        local foundAnyKeyItemIn200Studs = false
        local currentFoundObjects = {}

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local objectName = obj.Name:lower()

                if targetNames[objectName] then
                    currentFoundObjects[obj] = true
                    local dist = getClosestDistanceToModel(obj, hrp.Position)

                    if dist <= 200 then
                        foundAnyKeyItemIn200Studs = true
                        createHighlight(obj)
                    else
                        removeHighlight(obj)
                    end
                end

            elseif obj:IsA("BasePart") then
                local objectName = obj.Name:lower()

                if targetNames[objectName] then
                    local parentModel = obj:FindFirstAncestorOfClass("Model")

                    if not parentModel or not targetNames[parentModel.Name:lower()] then
                        currentFoundObjects[obj] = true
                        local dist = getClosestDistanceToPart(obj, hrp.Position)

                        if dist <= 200 then
                            foundAnyKeyItemIn200Studs = true
                            createHighlight(obj)
                        else
                            removeHighlight(obj)
                        end
                    end
                end
            end
        end

        for obj, highlight in pairs(activeHighlights) do
            if not obj or not obj.Parent or not currentFoundObjects[obj] then
                if highlight and highlight.Parent then
                    highlight:Destroy()
                end
                activeHighlights[obj] = nil
            end
        end

        if foundAnyKeyItemIn200Studs then
            if not isKeyItemNearby then
                isKeyItemNearby = true
                toggleParticlesInPart1And2(false)
                proximityShake.targetMagnMult = 0
            end
        else
            if isKeyItemNearby then
                isKeyItemNearby = false
                toggleParticlesInPart1And2(true)
            end
        end
    end
end)

task.spawn(function()
    local targetEntities = {
        ["Angler"] = true,
        ["Blitz"] = true,
        ["Froger"] = true,
        ["Chainsmoker"] = true,
        ["Pinkie"] = true
    }

    local activeTriggeredObjects = {}

    local function spawnPlayerDetectorLight()
        local char = player.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local pLight = Instance.new("PointLight")
        pLight.Name = "EntityDetectorGreenLight"
        pLight.Color = Color3.fromRGB(0, 255, 0)
        pLight.Brightness = 0
        pLight.Range = 12
        pLight.Shadows = false
        pLight.Parent = hrp

        local fadeIn = TweenService:Create(
            pLight,
            TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Brightness = 1}
        )
        fadeIn:Play()

        task.wait(9.0)

        if pLight and pLight.Parent then
            local fadeOut = TweenService:Create(
                pLight,
                TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {Brightness = 0}
            )
            fadeOut:Play()
            fadeOut.Completed:Wait()
            pLight:Destroy()
        end
    end

    while true do
        task.wait(0.4)

        for _, desc in ipairs(workspace:GetDescendants()) do
            if targetEntities[desc.Name] then
                if not activeTriggeredObjects[desc] then
                    activeTriggeredObjects[desc] = true

                    task.spawn(spawnPlayerDetectorLight)

                    desc.AncestryChanged:Connect(function(_, parent)
                        if not parent then
                            activeTriggeredObjects[desc] = nil
                        end
                    end)
                end
            end
        end
    end
end)
