            effectConnection = RunService.RenderStepped:Connect(function(dt)
                scrollPos = (scrollPos + 0.35 * (dt * 60)) % 1
                img1.Position = UDim2.new(0.5, 0, scrollPos + 0.5, 0)
                img2.Position = UDim2.new(0.5, 0, scrollPos - 0.5, 0)

                if math.random(1, 2) == 1 then
                    img1.Rotation = math.random(0, 1) * 180
                    img2.Rotation = math.random(0, 1) * 180
                end

                local glitchX = (math.random() - 0.5) * 0.05
                container.Position = UDim2.new(glitchX, 0, 0, 0)
            end)

            if sound and sound.IsPlaying then
                sound.Ended:Wait()
            else
                task.wait(1.5)
            end

            task.wait(0.35)

            if effectConnection then effectConnection:Disconnect() end

            -- KÍCH HOẠT GIẾT NGƯỜI CHƠI TRƯỚC KHI JUMPSCARE KẾT THÚC ĐÚNG 0.6 GIÂY
