local TweenService = game:GetService("TweenService")

-- ========================================================
-- HÀM TẢI VÀ TẠO ÂM THANH TỪ GITHUB
-- ========================================================
local function GitAud(soundlink, filename)
    local FileName = filename .. ".mp3"
    if not isfile(FileName) then
        writefile(FileName, game:HttpGet(soundlink))
    end
    return (getcustomasset or getsynasset)(FileName)
end

local function AttachEntitySound(parent, soundUrl, fileName, volume, minDist, maxDist)
    local sound = Instance.new("Sound")
    sound.SoundId = GitAud(soundUrl, fileName)
    sound.Volume = volume or 1
    sound.Looped = true
    sound.RollOffMinDistance = minDist
    sound.RollOffMaxDistance = maxDist
    sound.RollOffMode = Enum.RollOffMode.InverseTapered
    sound.Parent = parent
    return sound
end

-- Biến lưu trữ âm thanh & trạng thái thực thể
local idleSound = nil
local chaseSound = nil
local isCatched = false

-- Hàm xử lý sự kiện khi bắt được người chơi
local function TriggerCatch(actualEntity)
    if isCatched then return end
    isCatched = true

    -- Tắt tiếng Far Loop ngay lập tức
    if idleSound then idleSound:Destroy() end

    -- Tách chaseSound ra khỏi thực thể (gắn vào soundAnchor độc lập trong Workspace)
    if chaseSound and chaseSound.Parent then
        local targetPart = actualEntity and (actualEntity:IsA("BasePart") and actualEntity or actualEntity:FindFirstChildWhichIsA("BasePart"))
        
        local soundAnchor = Instance.new("Part")
        soundAnchor.Name = "SilenceSoundAnchor"
        soundAnchor.Size = Vector3.new(1, 1, 1)
        soundAnchor.Anchored = true
        soundAnchor.CanCollide = false
        soundAnchor.Transparency = 1
        if targetPart then
            soundAnchor.CFrame = targetPart.CFrame
        end
        soundAnchor.Parent = workspace

        -- Chuyển Parent của âm thanh sang Anchor để không bị xóa khi hủy model Silence
        chaseSound.Parent = soundAnchor

        -- Cho tiếng hét phát tiếp 2s rồi Fade Out trong 0.5s
        task.spawn(function()
            task.wait(2)
            if chaseSound and chaseSound.Parent then
                local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear)
                local tween = TweenService:Create(chaseSound, tweenInfo, {Volume = 0})
                tween:Play()
                tween.Completed:Connect(function()
                    chaseSound:Destroy()
                    soundAnchor:Destroy()
                end)
            else
                soundAnchor:Destroy()
            end
        end)
    end

    -- Thực thể giữ nguyên mô hình thêm 0.7s rồi mới biến mất
    task.delay(0.7, function()
        if actualEntity and actualEntity.Parent then
            actualEntity:Destroy()
        end
    end)

    -- Kích hoạt minigame ngay lập tức
    task.spawn(function()
        pcall(function()
            loadstring(game:HttpGet("https://github.com/Cyrene611/-3-_-3-M0D3/raw/refs/heads/main/silence%20mini.txt"))()
        end)
    end)
end

