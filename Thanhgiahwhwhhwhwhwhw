        ["sustain"] = true,
        ["isSustained"] = true,
        ["isContinuous"] = true,
        ["currentFadeTime"] = 0,
        ["tick"] = Random.new():NextNumber(-100, 100)
    }
    table.insert(activeShaker._camShakeInstances, inst)
    return inst
