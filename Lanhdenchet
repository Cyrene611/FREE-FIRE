local function shakeCamera(presetName)
    if isKeyItemNearby then
        return
    end

    local intenseMult = (currentPhase == 3) and (1.12 * 1.3) or ((currentPhase == 2) and 1.12 or 1.0)

    if presetName == "Explosion" then
        addCameraShake({
            Magnitude = 6.0 * intenseMult,
            Roughness = 18,
            FadeIn = 0,
            SustainTime = 0,
            FadeOut = 1.2,
            PosInf = Vector3.new(0.2, 0.2, 0.2),
            RotInf = Vector3.new(1.8, 1.2, 1.8)
        })

        triggerIntenseSound()

    elseif presetName == "ImpactArrival" then
        addCameraShake({
            Magnitude = 7.5 * intenseMult,
            Roughness = 22,
            FadeIn = 0,
            SustainTime = 0,
            FadeOut = 0.8,
            PosInf = Vector3.new(0.25, 0.25, 0.25),
            RotInf = Vector3.new(2.2, 1.5, 1.5)
        })

        triggerIntenseSound()

    elseif presetName == "StartMove" then
        addCameraShake({
            Magnitude = 5.0 * intenseMult,
            Roughness = 15,
            FadeIn = 0.60,
            SustainTime = 1.0,
            FadeOut = 1.0,
            PosInf = Vector3.new(0.18, 0.18, 0.18),
            RotInf = Vector3.new(1.4, 1.0, 1.4)
        })

        triggerIntenseSound()
    end
end

RunService:BindToRenderStep(
    "BossCameraShaker",
    Enum.RenderPriority.Camera.Value + 100,
    function(dt)
        if isKeyItemNearby then
            return
        end

        local cam = workspace.CurrentCamera

        if not cam then
            return
        end

        local totalPos = Vector3.new()
        local totalRot = Vector3.new()

        for i = #activeShakeInstances, 1, -1 do
            local inst = activeShakeInstances[i]

            if inst.isContinuous then
                inst.currentMagnMult =
                    inst.currentMagnMult +
                    (inst.targetMagnMult - inst.currentMagnMult) *
                    math.min(dt * 8, 1)

                inst.currentAlpha = 1
            else
                if inst.FadeIn > 0 and inst.timePassed < inst.FadeIn then
                    inst.timePassed = inst.timePassed + dt
                    inst.currentAlpha =
                        math.clamp(inst.timePassed / inst.FadeIn, 0, 1)

                elseif inst.sustainLeft > 0 then
                    inst.sustainLeft = inst.sustainLeft - dt
                    inst.currentAlpha = 1

                elseif inst.FadeOut > 0 then
                    inst.currentAlpha =
                        inst.currentAlpha - (dt / inst.FadeOut)

                    if inst.currentAlpha <= 0 then
                        inst.currentAlpha = 0
                        inst.isDone = true
                    end

                else
                    inst.isDone = true
                end
            end

            if inst.isDone then
                table.remove(activeShakeInstances, i)
            else
                inst.tick = inst.tick + dt * inst.Roughness

                local noiseX =
                    math.noise(inst.tick + 0.1, 10.5, 0.7) * 2

                local noiseY =
                    math.noise(0.4, inst.tick + 0.2, 10.5) * 2

                local noiseZ =
                    math.noise(10.5, 0.8, inst.tick + 0.3) * 2

                local effMag =
                    inst.Magnitude *
                    inst.currentAlpha *
                    (inst.isContinuous and inst.currentMagnMult or 1)

                totalPos =
                    totalPos +
                    Vector3.new(
                        noiseX * inst.PosInf.X,
                        noiseY * inst.PosInf.Y,
                        noiseZ * inst.PosInf.Z
                    ) *
                    effMag

                totalRot =
                    totalRot +
                    Vector3.new(
                        noiseX * inst.RotInf.X,
                        noiseY * inst.RotInf.Y,
                        noiseZ * inst.RotInf.Z
                    ) *
                    effMag
            end
        end

        if totalPos.Magnitude > 0 or totalRot.Magnitude > 0 then
            cam.CFrame =
                cam.CFrame *
                CFrame.new(totalPos) *
                CFrame.Angles(
                    math.rad(totalRot.X),
                    math.rad(totalRot.Y),
                    math.rad(totalRot.Z)
                )
        end
    end
)

