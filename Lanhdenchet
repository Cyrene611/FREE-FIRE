            end
        end)
    end

    frostBar.Visible = true
    frostBar.AnchorPoint = Vector2.new(0.5, 0.5)
    frostBar.Rotation = 0

    for _, desc in ipairs(frostBar:GetDescendants()) do
        if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            desc.ImageTransparency = desc:GetAttribute("OrigImgTrans") or 0
        elseif desc:IsA("TextLabel") or desc:IsA("TextButton") then
            desc.TextTransparency = desc:GetAttribute("OrigTextTrans") or 0
        end

        if desc:IsA("GuiObject") then
            desc.BackgroundTransparency = desc:GetAttribute("OrigBgTrans") or 1
        elseif desc:IsA("UIStroke") then
            desc.Transparency = desc:GetAttribute("OrigStrokeTrans") or 0
        end
    end

    local originalSize = frostBar.Size
    local targetScaledSize = UDim2.new(
        originalSize.X.Scale * 1.5,
        originalSize.X.Offset * 1.5,
        originalSize.Y.Scale * 1.5,
        originalSize.Y.Offset * 1.5
    )

    local centerTween = TweenService:Create(
        frostBar,
        TweenInfo.new(
            0.75,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = targetScaledSize,
            Rotation = 0
        }
    )

    centerTween:Play()
    centerTween.Completed:Wait()

    task.wait(0.25)

    local shakeStart = os.clock()

    local shakeConnection
    shakeConnection = RunService.RenderStepped:Connect(function()
        local elapsed = os.clock() - shakeStart

        if elapsed >= 0.75 then
            return
        end

        local progress = elapsed / 0.75
        local strength = 14 + (progress * 12)

        local shakeX = math.random(-math.floor(strength), math.floor(strength))
        local shakeY = math.random(-math.floor(strength), math.floor(strength))
        local rotation = math.random(-12, 12)

        frostBar.Position = UDim2.new(0.5, shakeX, 0.5, shakeY)
        frostBar.Rotation = rotation
    end)

    task.wait(0.75)

    if shakeConnection then
        shakeConnection:Disconnect()
    end

    frostBar.Position = UDim2.new(0.5, 0, 0.5, 0)
    frostBar.Rotation = 0

    task.wait(0.2)

    shakeCamera("Explosion")

    local fallStart = os.clock()
    local xVelocity = math.random(-38, 38)
    local yVelocity = -120
    local gravity = 750
    local rotationVelocity = math.random(-120, 120)

    local fallConnection
    fallConnection = RunService.RenderStepped:Connect(function()
        local elapsed = os.clock() - fallStart

        if elapsed > 2.0 then
            if fallConnection then
                fallConnection:Disconnect()
                fallConnection = nil
            end
            return
        end

        local currentX = xVelocity * elapsed
        local currentY = yVelocity * elapsed + 0.5 * gravity * elapsed * elapsed

        frostBar.Position = UDim2.new(0.5, currentX, 0.5, currentY)
        frostBar.Rotation = rotationVelocity * elapsed

        local fadeStart = 1.2
        if elapsed > fadeStart then
            local fadeProgress = math.clamp((elapsed - fadeStart) / 0.7, 0, 1)

            for _, desc in ipairs(frostBar:GetDescendants()) do
                if desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                    desc.ImageTransparency = math.max(desc.ImageTransparency, fadeProgress)
                elseif desc:IsA("TextLabel") or desc:IsA("TextButton") then
                    desc.TextTransparency = math.max(desc.TextTransparency, fadeProgress)
                elseif desc:IsA("GuiObject") then
                    desc.BackgroundTransparency = math.max(desc.BackgroundTransparency, fadeProgress)
                elseif desc:IsA("UIStroke") then
                    desc.Transparency = math.max(desc.Transparency, fadeProgress)
                end
            end
        end
    end)

    task.delay(2.1, function()
        if fallConnection then
            fallConnection:Disconnect()
            fallConnection = nil
        end
        frostBar.Visible = false
    end)

    task.delay(0.15, function()
        isPhase3Transition = false

        if phase3Music then
            phase3Music.Volume = 3.0
            phase3Music:Play()
        end
    end)
end

